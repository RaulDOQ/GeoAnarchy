---
// One address the visitor can copy: a label, the value in mono type and a copy button.
import Icon from './Icon.astro';
import { pt } from '../content/pt';

interface Props {
  label: string;
  value: string;
}

const { label, value } = Astro.props;
const c = pt.common;
---

<div class="copy-field">
  <div class="copy-text">
    <span class="mono-label">{label}</span>
    <code>{value}</code>
  </div>
  <button class="copy-btn" type="button" data-copy={value} aria-label={`${c.copy}: ${value}`}>
    <span class="idle"><Icon name="copy" />{c.copy}</span>
    <span class="done" aria-hidden="true"><Icon name="check" />{c.copied}</span>
  </button>
</div>

<style>
  .copy-field {
    background: var(--paper-tint);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-control);
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: .7rem .7rem .7rem .95rem;
    display: flex;
  }
  .copy-text {
    gap: .45rem;
    min-width: 0;
    display: grid;
  }
  code {
    font: 500 1.0625rem/1.2 var(--font-mono);
    letter-spacing: -.01em;
    color: var(--color-text);
    overflow-wrap: anywhere;
  }
  .copy-btn {
    cursor: pointer;
    height: 2.25rem;
    color: var(--color-text);
    background: var(--paper);
    border: 1px solid var(--line-strong);
    border-radius: .35rem;
    flex: none;
    padding: 0 .75rem;
    font-size: .8125rem;
    font-weight: 600;
    transition: border-color .2s, color .2s, transform .16s var(--ease-out);
    display: inline-grid;
  }
  .copy-btn:hover {
    border-color: var(--ink);
  }
  .copy-btn:active {
    transform: scale(.96);
  }
  .copy-btn > span {
    grid-area: 1 / 1;
    justify-content: center;
    align-items: center;
    gap: .4rem;
    transition: opacity .2s, transform .35s var(--spring-snappy);
    display: inline-flex;
  }
  .copy-btn :global(svg) {
    width: .9rem;
    height: .9rem;
  }
  .copy-btn .done {
    opacity: 0;
    transform: translateY(5px);
  }
  .copy-btn:global(.is-copied) {
    border-color: var(--green);
    color: var(--green-strong);
  }
  .copy-btn:global(.is-copied) .idle {
    opacity: 0;
    transform: translateY(-5px);
  }
  .copy-btn:global(.is-copied) .done {
    opacity: 1;
    transform: none;
  }
</style>
