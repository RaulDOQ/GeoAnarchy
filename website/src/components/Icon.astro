---
// Line icons, drawn on a 24 px grid. Colour and size come from the parent's CSS.
const paths = {
  flag: '<path d="M5.5 21V3.5"/><path d="M5.5 4.5h12l-2.4 4 2.4 4h-12"/>',
  territory: '<path d="M3.5 7 9 4.5l6 2.5 5.5-2.5v12.5L15 19.5 9 17l-5.5 2.5Z"/><path d="M9 4.5V17M15 7v12.5"/>',
  handshake: '<circle cx="9" cy="12" r="5.5"/><circle cx="15" cy="12" r="5.5"/>',
  swords: '<path d="M4.5 3.5 15 14"/><path d="M19.5 3.5 9 14"/><path d="m13 16.5 3.5-3.5"/><path d="M7.5 13 11 16.5"/><path d="m17 17 3 3"/><path d="m7 17-3 3"/>',
  copy: '<rect x="9" y="9" width="11" height="11" rx="2.5"/><path d="M5 15V6.5A2.5 2.5 0 0 1 7.5 4H15"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  arrowRight: '<path d="M5 12h14m-6-6 6 6-6 6"/>',
  arrowUpRight: '<path d="M7 17 17 7M8 7h9v9"/>',
  arrowDown: '<path d="M12 5v14m-6-6 6 6 6-6"/>',
  expand: '<path d="M9 4H4v5M15 4h5v5M9 20H4v-5M15 20h5v-5"/>',
  java: '<rect x="3" y="4.5" width="18" height="12" rx="2"/><path d="M8.5 20h7M12 16.5V20"/>',
  bedrock: '<rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M11 18h2"/>',
  chat: '<path d="M5 5.5h14A1.5 1.5 0 0 1 20.5 7v8a1.5 1.5 0 0 1-1.5 1.5h-6L8.5 20v-3.5H5A1.5 1.5 0 0 1 3.5 15V7A1.5 1.5 0 0 1 5 5.5Z"/>',
  lock: '<rect x="5" y="10.5" width="14" height="9.5" rx="2"/><path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5"/>',
  pointer: '<path d="m5 4 5.5 15 2.2-6.300L19 10.5 5 4Z"/>',
  player: '<circle cx="12" cy="8" r="3.75"/><path d="M4.5 20.500c.9-3.900 3.800-6 7.500-6s6.600 2.100 7.500 6"/>',
  arrowLeft: '<path d="M19 12H5m6 6-6-6 6-6"/>',
} as const;

export type IconName = keyof typeof paths;

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={paths[name]} />
