---
// The wiki's side menu: its sections, each a group that opens to show its articles. The
// section being read starts open and the others closed, so the menu stays short; a click on
// a section's name opens or closes it. The menu stays beside the article on a wide screen;
// on a phone it sits above the article, closed until tapped.
import type { WikiGroup } from '../../config/wiki';
import { pt } from '../../content/pt';

interface Props {
  groups: WikiGroup[];
}

const { groups } = Astro.props;
const c = pt.wiki;
const number = (i: number) => String(i + 1).padStart(2, '0');
---

<details class="index card" open data-wiki-menu>
  <summary class="index-head">
    <span class="label">{c.indexLabel}</span>
    <span class="pm" aria-hidden="true"></span>
  </summary>
  <nav aria-label={c.indexLabel}>
    {
      groups.map((group) => (
        <details class="group" open={group.open}>
          <summary class="group-title">
            <span class="group-name">{group.title}</span>
            <span class="count" aria-label={c.groupCount.replace('{n}', String(group.links.length))}>
              {group.links.length}
            </span>
            <svg class="chev" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M6 4l4 4-4 4" />
            </svg>
          </summary>
          <div class="links">
            {group.links.map((link, i) => (
              <a href={link.href} aria-current={link.current ? 'page' : undefined}>
                <span>{number(i)}</span>
                {link.label}
              </a>
            ))}
          </div>
        </details>
      ))
    }
    <p class="more">{pt.common.soon}</p>
  </nav>
</details>
{/* Runs at once, before the page paints: on a phone the menu starts closed, so the article comes first. */}
<script is:inline>
  (() => {
    const menu = document.querySelector('[data-wiki-menu]');
    const narrow = matchMedia('(width <= 900px)');
    if (!menu) return;
    if (narrow.matches) menu.removeAttribute('open');
    // Turning a tablet or widening the window brings the menu back beside the article, open.
    narrow.addEventListener('change', (event) => {
      if (!event.matches) menu.setAttribute('open', '');
    });
  })();
</script>

<style>
  .index {
    top: calc(var(--nav-offset) + 1.5rem);
    max-height: calc(100vh - var(--nav-offset) - 3rem);
    padding: .5rem .6rem .9rem;
    position: sticky;
    overflow-y: auto;
  }
  summary {
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .index-head {
    border-radius: .55rem;
    justify-content: space-between;
    align-items: center;
    padding: .7rem .6rem .6rem;
    display: flex;
  }
  nav {
    gap: .2rem;
    padding-top: .3rem;
    display: grid;
  }

  /* A section: its name, how many articles it has, and an arrow that turns when it opens. */
  .group-title {
    color: var(--color-text);
    letter-spacing: -.01em;
    border-radius: .55rem;
    align-items: center;
    gap: .5rem;
    padding: .55rem .6rem;
    font-size: .875rem;
    font-weight: 600;
    transition: background-color .2s;
    display: flex;
  }
  .group-title:hover {
    background: var(--color-surface-hover);
  }
  .group-name {
    flex: 1;
  }
  .count {
    min-width: 1.4rem;
    color: var(--color-text-faint);
    font-variant-numeric: tabular-nums;
    text-align: center;
    background: var(--color-bg-tint);
    box-shadow: inset 0 0 0 1px var(--color-hairline);
    border-radius: 999px;
    padding: .15rem .4rem;
    font-size: .6875rem;
    font-weight: 600;
    line-height: 1;
  }
  .chev {
    fill: none;
    stroke: var(--color-text-faint);
    stroke-width: 1.8px;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex: none;
    width: .9rem;
    height: .9rem;
    transition: transform .35s var(--spring-snappy);
  }
  .group[open] > summary .chev {
    transform: rotate(90deg);
  }
  .links {
    gap: .1rem;
    padding: .15rem 0 .6rem .5rem;
    display: grid;
  }

  a {
    color: var(--color-text-soft);
    border-radius: .55rem;
    align-items: baseline;
    gap: .7rem;
    padding: .45rem .6rem;
    font-size: .9rem;
    font-weight: 500;
    line-height: 1.3;
    transition: background-color .2s, color .2s;
    display: flex;
  }
  a:hover {
    color: var(--color-text);
    background: var(--color-surface-hover);
  }
  a[aria-current] {
    color: var(--color-blue-strong);
    background: var(--color-blue-soft);
    box-shadow: inset 0 0 0 1px var(--color-blue-ring);
    font-weight: 600;
  }
  a span {
    color: var(--color-blue-strong);
    font-variant-numeric: tabular-nums;
    font-size: .71875rem;
    font-weight: 600;
    line-height: 1;
  }
  .more {
    color: var(--color-text-faint);
    padding: .6rem .6rem 0;
    font-size: .8125rem;
  }

  /* A section slides open where the browser can animate it; elsewhere it opens at once. */
  @supports selector(::details-content) {
    .group::details-content {
      block-size: 0;
      transition: block-size .32s var(--ease-out), content-visibility .32s allow-discrete;
      overflow: clip;
    }
    .group[open]::details-content {
      block-size: auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .chev,
    .group::details-content {
      transition: none;
    }
  }

  /* On a wide screen the menu itself is always open, so its heading is just a label. */
  @media (width > 900px) {
    .index-head {
      pointer-events: none;
    }
    .index-head .pm {
      display: none;
    }
  }
  @media (width <= 900px) {
    .index {
      max-height: none;
      position: static;
    }
    .index:not([open]) {
      padding-bottom: .5rem;
    }
    .index-head {
      padding-bottom: .7rem;
    }
  }
</style>
