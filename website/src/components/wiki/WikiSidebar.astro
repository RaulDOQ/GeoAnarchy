---
// The wiki's side menu: its sections, each with its articles. It stays beside the article
// on a wide screen; on a phone it sits above the article, closed until tapped.
import type { WikiGroup } from '../../config/wiki';
import { pt } from '../../content/pt';

interface Props {
  groups: WikiGroup[];
}

const { groups } = Astro.props;
const c = pt.wiki;
const number = (i: number) => String(i + 1).padStart(2, '0');
---

<details class="index card" open data-wiki-menu>
  <summary>
    <span class="label">{c.indexLabel}</span>
    <span class="pm" aria-hidden="true"></span>
  </summary>
  <nav aria-label={c.indexLabel}>
    {
      groups.map((group) => (
        <div class="group">
          <p class="group-title">{group.title}</p>
          {group.links.map((link, i) => (
            <a href={link.href} aria-current={link.current ? 'page' : undefined}>
              <span>{number(i)}</span>
              {link.label}
            </a>
          ))}
        </div>
      ))
    }
    <p class="more">{pt.common.soon}</p>
  </nav>
</details>
{/* Runs at once, before the page paints: on a phone the menu starts closed, so the article comes first. */}
<script is:inline>
  (() => {
    const menu = document.querySelector('[data-wiki-menu]');
    const narrow = matchMedia('(width <= 900px)');
    if (!menu) return;
    if (narrow.matches) menu.removeAttribute('open');
    // Turning a tablet or widening the window brings the menu back beside the article, open.
    narrow.addEventListener('change', (event) => {
      if (!event.matches) menu.setAttribute('open', '');
    });
  })();
</script>

<style>
  .index {
    top: calc(var(--nav-offset) + 1.5rem);
    max-height: calc(100vh - var(--nav-offset) - 3rem);
    padding: .5rem .6rem .9rem;
    position: sticky;
    overflow-y: auto;
  }
  summary {
    cursor: pointer;
    border-radius: .55rem;
    justify-content: space-between;
    align-items: center;
    padding: .7rem .6rem .6rem;
    list-style: none;
    display: flex;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  nav {
    gap: 1.1rem;
    padding-top: .3rem;
    display: grid;
  }
  .group {
    gap: .1rem;
    display: grid;
  }
  .group-title {
    color: var(--color-text);
    letter-spacing: -.01em;
    padding: 0 .6rem .35rem;
    font-size: .875rem;
    font-weight: 600;
  }
  a {
    color: var(--color-text-soft);
    border-radius: .55rem;
    align-items: baseline;
    gap: .7rem;
    padding: .45rem .6rem;
    font-size: .9rem;
    font-weight: 500;
    line-height: 1.3;
    transition: background-color .2s, color .2s;
    display: flex;
  }
  a:hover {
    color: var(--color-text);
    background: var(--color-surface-hover);
  }
  a[aria-current] {
    color: var(--color-blue-strong);
    background: var(--color-blue-soft);
    box-shadow: inset 0 0 0 1px var(--color-blue-ring);
    font-weight: 600;
  }
  a span {
    color: var(--color-blue-strong);
    font-variant-numeric: tabular-nums;
    font-size: .71875rem;
    font-weight: 600;
    line-height: 1;
  }
  .more {
    color: var(--color-text-faint);
    padding: 0 .6rem;
    font-size: .8125rem;
  }
  /* On a wide screen the menu is always open, so its heading is just a label. */
  @media (width > 900px) {
    summary {
      pointer-events: none;
    }
    .pm {
      display: none;
    }
  }
  @media (width <= 900px) {
    .index {
      max-height: none;
      position: static;
    }
    .index:not([open]) {
      padding-bottom: .5rem;
    }
    summary {
      padding-bottom: .7rem;
    }
  }
</style>
