---
// A list of a section's articles, each with its summary: the way into the long articles
// from a wiki's front page.
import Icon from '../Icon.astro';
import { articleHref, sectionArticles, type WikiId } from '../../config/wiki';

interface Props {
  wiki: WikiId;
  section: string;
}

const { wiki, section } = Astro.props;
const articles = await sectionArticles(wiki, section);
const number = (i: number) => String(i + 1).padStart(2, '0');
---

<ol class="topics card" data-in="settle" style="--d: 100ms">
  {
    articles.map((article, i) => (
      <li>
        <a href={articleHref(article)}>
          <span class="num">{number(i)}</span>
          <span class="text">
            <span class="name">{article.data.title}</span>
            <span class="summary">{article.data.summary}</span>
          </span>
          <Icon name="arrowRight" />
        </a>
      </li>
    ))
  }
</ol>

<style>
  .topics {
    gap: .15rem;
    padding: .5rem;
    list-style: none;
    display: grid;
  }
  a {
    border-radius: .8rem;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    padding: .85rem 1rem;
    transition: background-color .2s;
    display: grid;
  }
  a:hover {
    background: var(--color-surface-hover);
  }
  .num {
    min-width: 1.75rem;
    height: 1.375rem;
    box-shadow: inset 0 0 0 1px var(--color-blue-ring);
    color: var(--color-blue-strong);
    font-variant-numeric: tabular-nums;
    background: var(--color-blue-soft);
    border-radius: .4rem;
    place-items: center;
    padding: 0 .35rem;
    font-size: .71875rem;
    font-weight: 600;
    line-height: 1;
    display: inline-grid;
  }
  .text {
    gap: .2rem;
    display: grid;
  }
  .name {
    color: var(--color-text);
    letter-spacing: -.01em;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .summary {
    color: var(--color-text-muted);
    font-size: .9375rem;
    line-height: 1.5;
  }
  a :global(svg) {
    color: var(--color-text-faint);
    width: 1rem;
    height: 1rem;
    transition: transform .4s var(--spring-snappy), color .2s;
  }
  a:hover :global(svg) {
    color: var(--color-blue-strong);
    transform: translate(3px);
  }
  @media (width <= 520px) {
    a {
      grid-template-columns: auto minmax(0, 1fr);
      gap: .8rem;
      padding-inline: .7rem;
    }
    a :global(svg) {
      display: none;
    }
  }
</style>
