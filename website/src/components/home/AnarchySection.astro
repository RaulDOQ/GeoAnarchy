---
// "Anarquia": the server's rule is that there are no political rules. Two panels put
// the two extremes side by side, each with blocks behind it: scattered for war and
// chaos, in formation for order and peace.
import SectionHead from './SectionHead.astro';
import { pt } from '../../content/pt';

const c = pt.anarchy;

// A small steady random generator, so the scattered blocks are the same on every build.
function mulberry(seed: number) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const COLS = 14;
const ROWS = 7;
const random = mulberry(1914);
const tones = ['a', 'a', 'b', 'c'];
const scattered: { x: number; y: number; r: number; tone: string }[] = [];
const ordered: { x: number; y: number; tone: string }[] = [];
for (let y = 0; y < ROWS; y++) {
  for (let x = 0; x < COLS; x++) {
    // Order: every block in place, in even bands.
    ordered.push({ x, y, tone: y % 3 === 1 ? 'b' : 'a' });
    // Chaos: about half the blocks are gone and the rest are knocked out of line.
    if (random() < 0.52) continue;
    scattered.push({
      x: x + (random() - 0.5) * 0.7,
      y: y + (random() - 0.5) * 0.7,
      r: Math.round((random() - 0.5) * 50),
      tone: tones[Math.floor(random() * tones.length)],
    });
  }
}
---

<section class="stage" id="anarquia">
  <div class="container">
    <SectionHead num="01" chapter={c.chapter} title={c.title} lead={c.lead} />

    <div class="paths">
      <article class="path chaos" data-in="settle" style="--d: 100ms">
        <svg class="blocks" viewBox={`-1 -1 ${COLS + 1} ${ROWS + 1}`} preserveAspectRatio="xMaxYMax slice" aria-hidden="true">
          {scattered.map((b) => <rect class={b.tone} x={b.x.toFixed(2)} y={b.y.toFixed(2)} width=".8" height=".8" transform={`rotate(${b.r} ${(b.x + 0.4).toFixed(2)} ${(b.y + 0.4).toFixed(2)})`} />)}
        </svg>
        <div class="words">
          <h3>{c.paths[0].question}</h3>
          <p>{c.paths[0].answer}</p>
        </div>
      </article>
      <article class="path order" data-in="settle" style="--d: 170ms">
        <svg class="blocks" viewBox={`-1 -1 ${COLS + 1} ${ROWS + 1}`} preserveAspectRatio="xMaxYMax slice" aria-hidden="true">
          {ordered.map((b) => <rect class={b.tone} x={b.x} y={b.y} width=".8" height=".8" />)}
        </svg>
        <div class="words">
          <h3>{c.paths[1].question}</h3>
          <p>{c.paths[1].answer}</p>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .paths {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    display: grid;
  }
  .path {
    border-radius: var(--radius-xl);
    min-height: 24rem;
    display: grid;
    position: relative;
    overflow: hidden;
  }
  .chaos {
    color: #fff;
    background: linear-gradient(180deg, #10263f, var(--color-ink));
    box-shadow: var(--shadow-lift);
  }
  .order {
    background: var(--grad-surface);
    box-shadow: var(--edge), var(--shadow-card);
  }
  /* The blocks fill the top of the panel and fade out before the words. */
  .blocks {
    width: 100%;
    height: 54%;
    position: absolute;
    top: 0;
    left: 0;
    -webkit-mask-image: linear-gradient(#000 50%, #0000 96%);
    mask-image: linear-gradient(#000 50%, #0000 96%);
  }
  .chaos .a {
    fill: var(--color-land-bright);
  }
  .chaos .b {
    fill: var(--color-blue-bright);
  }
  .chaos .c {
    fill: #ffffff;
  }
  .order .a {
    fill: var(--color-green);
  }
  .order .b {
    fill: var(--color-blue);
  }
  .words {
    align-self: end;
    gap: .9rem;
    max-width: 30rem;
    padding: 2rem;
    display: grid;
    position: relative;
  }
  h3 {
    letter-spacing: -.03em;
    font-size: clamp(1.45rem, 1.1rem + 1vw, 1.875rem);
    line-height: 1.15;
  }
  .words p {
    font-size: 1.0625rem;
    font-weight: 600;
  }
  .chaos .words p {
    color: var(--color-land-bright);
  }
  .order .words p {
    color: var(--color-blue-strong);
  }
  @media (width <= 800px) {
    .paths {
      grid-template-columns: minmax(0, 1fr);
    }
    .path {
      min-height: 21rem;
    }
    .blocks {
      height: 44%;
    }
    .words {
      padding: 1.4rem;
    }
  }
</style>
