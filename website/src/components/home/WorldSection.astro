---
// "O mapa": the size and scale of the Earth world, straight from config/site.ts.
import Icon from '../Icon.astro';
import SectionHead from './SectionHead.astro';
import { site } from '../../config/site';
import { pt } from '../../content/pt';

const c = pt.world;
---

<section class="stage" id="mapa">
  <div class="container">
    <SectionHead num="02" chapter={c.chapter} title={c.title} lead={c.lead}>
      <a class="learn" href={site.map.url} target="_blank" rel="noopener">{c.open}<Icon name="arrowRight" /></a>
    </SectionHead>

    <div class="facts card" data-in="settle" style="--d: 100ms">
      <dl>
        {
          c.facts.map((fact) => (
            <div class="fact">
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
      </dl>
      <p class="bounds">
        <span class="mono-label">{c.boundsLabel}</span>
        {c.bounds.map((line) => <code>{line}</code>)}
      </p>
    </div>

    <ul class="checks world-checks" data-in="settle" style="--d: 160ms">
      {c.checks.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</section>

<style>
  .stage-side .learn,
  :global(.stage-side) .learn {
    margin-top: 1.1rem;
  }
  .facts {
    overflow: hidden;
  }
  dl {
    grid-template-columns: 1.35fr 1fr 1fr;
    margin: 0;
    display: grid;
  }
  .fact {
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: .9rem;
    padding: 2.25rem 2rem 2rem;
    display: flex;
  }
  .fact + .fact {
    border-left: 1px solid var(--color-hairline);
  }
  dd {
    font: 500 clamp(1.7rem, 1rem + 1.9vw, 2.6rem)/1.05 var(--font-mono);
    letter-spacing: -.045em;
    color: #0000;
    white-space: nowrap;
    background: var(--grad-earth);
    -webkit-background-clip: text;
    background-clip: text;
    margin: 0;
    padding-bottom: .08em;
  }
  dt {
    color: var(--color-text-muted);
    max-width: 21rem;
    font-size: .9375rem;
    line-height: 1.45;
  }
  .bounds {
    border-top: 1px solid var(--color-hairline);
    background: #ffffff99;
    flex-wrap: wrap;
    align-items: center;
    gap: .6rem 1.5rem;
    padding: 1rem 2rem;
    display: flex;
  }
  .bounds code {
    color: var(--color-text-soft);
    font: 500 .8125rem/1.2 var(--font-mono);
    letter-spacing: -.01em;
    white-space: nowrap;
  }
  .world-checks {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .8rem 2rem;
    margin-top: 1.75rem;
    padding-inline: .25rem;
  }
  @media (width <= 900px) {
    dl {
      grid-template-columns: 1fr;
    }
    .fact {
      padding: 1.5rem 1.4rem;
    }
    .fact + .fact {
      border-top: 1px solid var(--color-hairline);
      border-left: 0;
    }
    .bounds {
      padding: 1rem 1.4rem;
    }
    .world-checks {
      grid-template-columns: 1fr;
    }
  }
</style>
