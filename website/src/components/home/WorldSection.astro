---
// "O mapa": the world drawn in blocks on a map sheet. The numbers along the edges are
// the real limits of the server's world, in game coordinates (config/site.ts).
import Icon from '../Icon.astro';
import PixelEarth from './PixelEarth.astro';
import SectionHead from './SectionHead.astro';
import { site } from '../../config/site';
import { pt } from '../../content/pt';

const c = pt.world;
---

<section class="stage" id="mapa">
  <div class="container">
    <SectionHead num="02" chapter={c.chapter} title={c.title} lead={c.lead}>
      <a class="learn" href={site.map.url} target="_blank" rel="noopener">{c.open}<Icon name="arrowRight" /></a>
    </SectionHead>

    <figure class="sheet" data-in="settle" style="--d: 100ms">
      <div class="axis-x" aria-hidden="true">
        <span class="axis-name">X</span>
        {c.axisX.map((value) => <span>{value}</span>)}
      </div>
      <div class="axis-z" aria-hidden="true">
        <span class="axis-name">Z</span>
        {c.axisZ.map((value) => <span>{value}</span>)}
      </div>
      <div class="map">
        <PixelEarth label={c.figureLabel} id="seams-world">
          <span class="cross h" aria-hidden="true"></span>
          <span class="cross v" aria-hidden="true"></span>
          <span class="tag origin" aria-hidden="true">{c.origin}</span>
          <span class="tag title" aria-hidden="true">{c.sheet}</span>
        </PixelEarth>
      </div>
      <figcaption>
        {
          c.facts.map((fact) => (
            <p>
              <strong>{fact.value}</strong>
              <span>{fact.label}</span>
            </p>
          ))
        }
      </figcaption>
    </figure>
  </div>
</section>

<style>
  :global(.stage-side) .learn {
    margin-top: 1.1rem;
  }
  /* The sheet: X along the top, Z down the left side, the map, then the legend. */
  .sheet {
    grid-template: "corner x" auto "z map" auto "legend legend" auto / 1.6rem minmax(0, 1fr);
    display: grid;
  }
  .axis-x,
  .axis-z {
    color: var(--color-text-muted);
    font: 500 .6875rem/1 var(--font-mono);
    letter-spacing: .02em;
    justify-content: space-between;
    display: flex;
    position: relative;
  }
  .axis-x {
    grid-area: x;
    padding-bottom: .55rem;
  }
  .axis-z {
    grid-area: z;
    writing-mode: vertical-rl;
    padding-right: .55rem;
    transform: rotate(180deg);
    flex-direction: row-reverse;
  }
  .axis-name {
    color: var(--blue);
    font-weight: 500;
    position: absolute;
  }
  .axis-x .axis-name {
    right: calc(100% + .65rem);
  }
  .axis-z .axis-name {
    display: none;
  }
  /* The first and last labels sit at the map's edges; the others are centred on their line. */
  .axis-x span:not(.axis-name):nth-child(3),
  .axis-x span:not(.axis-name):nth-child(4),
  .axis-x span:not(.axis-name):nth-child(5) {
    flex: 1;
    text-align: center;
  }
  .axis-x span:nth-child(2),
  .axis-x span:nth-child(6) {
    flex: .5;
  }
  .axis-x span:nth-child(6) {
    text-align: right;
  }
  .map {
    border: 1px solid var(--ink);
    grid-area: map;
  }
  .cross {
    background: #ffffff80;
    position: absolute;
  }
  .cross.h {
    height: 1px;
    top: 50%;
    left: 0;
    right: 0;
  }
  .cross.v {
    width: 1px;
    top: 0;
    bottom: 0;
    left: 50%;
  }
  .tag {
    color: var(--ink);
    font: 500 .6875rem/1 var(--font-mono);
    letter-spacing: .06em;
    text-transform: uppercase;
    white-space: nowrap;
    background: #fff;
    border: 1px solid var(--ink);
    padding: .4rem .5rem;
    position: absolute;
  }
  .origin {
    top: calc(50% + .5rem);
    left: calc(50% + .5rem);
  }
  .title {
    bottom: .75rem;
    left: .75rem;
  }
  figcaption {
    border-bottom: 1px solid var(--line-strong);
    grid-area: legend;
    grid-template-columns: 1.3fr 1fr 1fr;
    margin-left: 1.6rem;
    display: grid;
  }
  figcaption p {
    gap: .45rem;
    padding: 1.4rem 1.5rem 1.4rem 0;
    display: grid;
  }
  figcaption p + p {
    border-left: 1px solid var(--line-strong);
    padding-left: 1.5rem;
  }
  figcaption strong {
    font: 500 clamp(1.25rem, .9rem + 1vw, 1.75rem)/1.1 var(--font-mono);
    letter-spacing: -.04em;
    white-space: nowrap;
  }
  figcaption span {
    color: var(--color-text-muted);
    font-size: .9375rem;
    line-height: 1.4;
  }
  @media (width <= 800px) {
    .sheet {
      grid-template-columns: 1.25rem minmax(0, 1fr);
    }
    .axis-x,
    .axis-z {
      font-size: .5625rem;
    }
    .axis-x .axis-name {
      right: calc(100% + .45rem);
    }
    .tag {
      font-size: .5625rem;
      padding: .3rem .35rem;
    }
    .origin {
      top: calc(50% + .3rem);
      left: calc(50% + .3rem);
    }
    .title {
      display: none;
    }
    figcaption {
      grid-template-columns: 1fr;
      margin-left: 0;
    }
    figcaption p {
      padding: 1.1rem 0;
    }
    figcaption p + p {
      border-top: 1px solid var(--line-strong);
      border-left: 0;
      padding-left: 0;
    }
  }
</style>
