---
import Icon from '../Icon.astro';
import { site } from '../../config/site';
import { pt } from '../../content/pt';

const c = pt.closing;
---

<section class="closing container">
  <h2 class="closing-title" data-in="lines">
    <span class="line"><span>{c.title[0]}</span></span>
    <span class="line"><span class="accent">{c.title[1]}</span></span>
  </h2>
  <div class="closing-cta" data-in="settle" style="--d: 200ms">
    <a class="btn-solid" href="#entrar">{pt.join.chapter}</a>
    <a class="btn-line" href={site.discordUrl} target="_blank" rel="noopener">{pt.common.discord}<Icon name="arrowUpRight" class="arrow" /></a>
  </div>
  <p class="note mono-label" data-in="dissolve" style="--d: 400ms">{c.note}</p>
</section>

<style>
  .closing {
    text-align: center;
    padding-block: clamp(8rem, 4rem + 9vw, 13rem) 2rem;
    position: relative;
  }
  .closing-title {
    letter-spacing: -.045em;
    font-size: clamp(2.6rem, 1.4rem + 3.4vw, 4rem);
    font-weight: 700;
    line-height: 1.04;
  }
  .closing-cta {
    flex-wrap: wrap;
    justify-content: center;
    gap: .625rem;
    margin-top: 2.25rem;
    display: flex;
  }
  .closing-cta > * {
    min-height: 3rem;
  }
  .note {
    margin-top: 2.75rem;
  }
  @media (width <= 720px) {
    .closing-title {
      font-size: clamp(2.2rem, 1.4rem + 5vw, 3rem);
    }
  }
</style>
