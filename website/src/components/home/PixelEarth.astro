---
// The blocky world map (src/assets/earth.png, one pixel per 2.5 degrees), shown
// enlarged with sharp pixel edges on a blue sea. `crop` picks a part of it, in map
// pixels. Anything placed inside is drawn on top (routes, labels).
import earth from '../../assets/earth.png';

interface Props {
  label: string;
  crop?: { x: number; y: number; w: number; h: number };
  /** Gradient and pattern ids must be unique on a page. */
  id: string;
}

const { label, crop = { x: 0, y: 0, w: earth.width, h: earth.height }, id } = Astro.props;
const style = `--cx: ${crop.x}; --cy: ${crop.y}; --cw: ${crop.w}; --ch: ${crop.h}; --mw: ${earth.width}; --mh: ${earth.height}`;
---

<div class="pixel-earth" style={style} role="img" aria-label={label}>
  <img src={earth.src} alt="" width={earth.width} height={earth.height} loading="lazy" decoding="async" />
  {/* Thin sea-coloured lines between the pixels, so each one reads as a block. */}
  <svg class="seams" viewBox={`0 0 ${crop.w} ${crop.h}`} preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <pattern id={id} width="1" height="1" patternUnits="userSpaceOnUse">
        <path d="M1 0H0V1" fill="none" stroke-width=".1"></path>
      </pattern>
    </defs>
    <rect width={crop.w} height={crop.h} fill={`url(#${id})`}></rect>
  </svg>
  <slot />
</div>

<style>
  .pixel-earth {
    aspect-ratio: var(--cw) / var(--ch);
    background: var(--ocean);
    position: relative;
    overflow: hidden;
  }
  img {
    image-rendering: crisp-edges;
    image-rendering: pixelated;
    width: calc(var(--mw) / var(--cw) * 100%);
    max-width: none;
    height: calc(var(--mh) / var(--ch) * 100%);
    position: absolute;
    top: calc(var(--cy) / var(--ch) * -100%);
    left: calc(var(--cx) / var(--cw) * -100%);
  }
  .seams {
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
  }
  .seams path {
    stroke: var(--ocean);
    stroke-opacity: .5;
  }
</style>
