---
// The live map card (the hero's centrepiece): the name above, the map in a plain card,
// and one line under it saying whether the map is live. scripts/live-map.ts decides
// what is shown and lets the visitor zoom in; scripts/tilt.ts makes the card drift.
import Icon from '../Icon.astro';
import Wordmark from '../Wordmark.astro';
import view from '../../generated/map-view.json';
import { mapEmbedUrl, site } from '../../config/site';
import { pt } from '../../content/pt';

const c = pt.liveMap;
---

<figure
  class="livemap"
  data-livemap
  data-width={view.width}
  data-height={view.height}
  data-probe={`${site.map.url}images/blank.png`}
  data-snapshot-info="/api/map-snapshot.json"
  data-offline-text={c.offline}
  style={`--map-w: ${view.width}; --map-h: ${view.height}`}
>
  <div class="livemap-logo"><Wordmark width={140} alt={site.name} /></div>

  <div class="livemap-stage">
    <span class="livemap-shadow" aria-hidden="true"></span>
    <div class="livemap-card">
      {/* The map at its real size; the script scales and moves this whole layer. */}
      <div class="livemap-world" data-world style={`width: ${view.width}px; height: ${view.height}px`}>
        <img class="livemap-snapshot" data-snapshot alt="" decoding="async" />
        <iframe data-src={mapEmbedUrl(view)} title={c.label} tabindex="-1" aria-hidden="true" scrolling="no" referrerpolicy="strict-origin-when-cross-origin"></iframe>
      </div>
      <p class="livemap-note" aria-live="polite"><span class="spinner" aria-hidden="true"></span><span data-note-text>{c.loading}</span></p>
      {/* The pad takes every pointer and key, so the map inside is never touched. */}
      <div class="livemap-pad" data-pad tabindex="0" role="application" aria-label={c.label}>
        <span class="pad-pill idle"><Icon name="pointer" />{c.activate}</span>
        <span class="pad-pill busy for-mouse">{c.hint}</span>
        <span class="pad-pill busy for-touch">{c.touchHint}</span>
      </div>
    </div>
  </div>

  <figcaption class="livemap-caption" data-caption data-live={c.caption} data-snapshot={c.snapshotCaption} data-offline={c.offlineCaption}>
    <i class="dot" aria-hidden="true"></i>
    <span data-caption-text>{c.caption}</span>
  </figcaption>

  <noscript>
    <p class="livemap-noscript"><a href={site.map.url}>{site.map.host}</a></p>
  </noscript>
</figure>

<script>
  import { initLiveMap } from '../../scripts/live-map';
  document.querySelectorAll<HTMLElement>('[data-livemap]').forEach(initLiveMap);
</script>

<style>
  .livemap {
    justify-items: center;
    gap: 1.15rem;
    width: 100%;
    display: grid;
    position: relative;
  }
  .livemap-logo {
    display: flex;
  }
  .livemap-stage {
    perspective: 1500px;
    width: 100%;
    position: relative;
  }
  .livemap-shadow {
    filter: blur(26px);
    opacity: .5;
    background: radial-gradient(closest-side, #0a2a5c66, #0a2a5c00);
    height: 3.5rem;
    transform: translate(var(--sx, 0px), var(--sy, 0px));
    position: absolute;
    inset: auto 6% -1.6rem;
  }
  /* The card: nothing but the map. */
  .livemap-card {
    aspect-ratio: var(--map-w) / var(--map-h);
    background: #dbe7f6;
    border-radius: .9rem;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) translateY(var(--ty, 0px));
    will-change: transform;
    transition: box-shadow .3s ease-out;
    position: relative;
    overflow: hidden;
    box-shadow:
      0 0 0 1px #0a1b2e1f,
      0 40px 80px -36px #0a2a5c66,
      0 18px 36px -22px #0a1b2e47;
  }
  .livemap:global(.is-active) .livemap-card {
    box-shadow:
      0 0 0 1px var(--color-blue),
      0 0 0 4px var(--color-blue-ring),
      0 40px 80px -36px #0a2a5c66;
  }
  .livemap-world {
    transform-origin: 0 0;
    opacity: 0;
    will-change: transform;
    position: absolute;
    top: 0;
    left: 0;
  }
  .livemap:global(.is-ready) .livemap-world {
    opacity: 1;
  }
  .livemap-snapshot,
  iframe {
    opacity: 0;
    border: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    transition: opacity .6s ease-out;
    display: block;
    position: absolute;
    inset: 0;
  }
  iframe {
    pointer-events: none;
  }
  .livemap:global(.has-snapshot) .livemap-snapshot,
  .livemap:global(.is-live) iframe {
    opacity: 1;
  }
  /* Shown only while there is nothing to show yet, or nothing at all. */
  .livemap-note {
    color: var(--color-text-muted);
    align-items: center;
    gap: .7rem;
    font-size: .875rem;
    font-weight: 500;
    transition: opacity .4s ease-out;
    display: flex;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }
  .livemap:global(.is-live) .livemap-note,
  .livemap:global(.has-snapshot) .livemap-note {
    opacity: 0;
  }
  .spinner {
    border: 2px solid #1766e033;
    border-top-color: var(--color-blue);
    border-radius: 50%;
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    animation: spin .9s linear infinite;
  }
  .livemap:global(.is-offline) .spinner {
    display: none;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .livemap-pad {
    cursor: pointer;
    touch-action: pan-y;
    -webkit-user-select: none;
    user-select: none;
    place-items: end center;
    padding-bottom: .9rem;
    display: grid;
    position: absolute;
    inset: 0;
  }
  .livemap-pad:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: -4px;
    border-radius: .9rem;
  }
  .livemap:global(.is-active) .livemap-pad {
    cursor: zoom-in;
  }
  .livemap:global(.is-active.is-zoomed) .livemap-pad {
    cursor: grab;
  }
  .livemap:global(.is-dragging) .livemap-pad {
    cursor: grabbing;
  }
  /* One small hint at the bottom of the map, only while the pointer is over it. */
  .pad-pill {
    grid-area: 1 / 1;
    pointer-events: none;
    color: #fff;
    opacity: 0;
    white-space: nowrap;
    background: #0a1b2ee6;
    border-radius: 999px;
    align-items: center;
    gap: .5rem;
    padding: .5rem .85rem;
    font-size: .78125rem;
    font-weight: 600;
    transition: opacity .25s ease-out, transform .45s var(--spring-snappy);
    display: inline-flex;
    transform: translateY(6px);
    box-shadow: 0 10px 24px -10px #0a1b2e99;
  }
  .pad-pill :global(svg) {
    width: .85rem;
    height: .85rem;
  }
  .for-touch {
    display: none;
  }
  @media (hover: hover) {
    .livemap:not(:global(.is-active)) .livemap-pad:hover .idle,
    .livemap:not(:global(.is-active)) .livemap-pad:focus-visible .idle {
      opacity: 1;
      transform: none;
    }
    .livemap:global(.is-active) .busy.for-mouse {
      animation: hint 3.4s ease-out both;
    }
  }
  @media (hover: none) {
    .for-mouse {
      display: none;
    }
    .for-touch {
      display: inline-flex;
    }
    .livemap:global(.is-active) .busy.for-touch {
      animation: hint 2.4s ease-out both;
    }
  }
  @keyframes hint {
    0%,
    70% {
      opacity: 1;
      transform: none;
    }
    to {
      opacity: 0;
      transform: none;
    }
  }
  /* The line under the map: grey until the live map answers, green while it is live. */
  .livemap-caption {
    box-shadow: var(--edge);
    color: var(--color-text-muted);
    letter-spacing: -.005em;
    text-align: center;
    background: var(--color-surface);
    border-radius: 999px;
    align-items: center;
    gap: .6rem;
    padding: .45rem .9rem .45rem .8rem;
    font-size: .84375rem;
    font-weight: 600;
    transition: color .3s, background-color .3s, box-shadow .3s;
    display: inline-flex;
  }
  .dot {
    background: var(--color-text-faint);
    border-radius: 50%;
    flex: none;
    width: 7px;
    height: 7px;
    transition: background-color .3s;
    position: relative;
  }
  .livemap:global(.is-live) .livemap-caption {
    box-shadow: inset 0 0 0 1px var(--color-green-ring);
    color: var(--color-green-strong);
    background: #f1fbf5;
  }
  .livemap:global(.is-live) .dot {
    background: var(--color-green);
  }
  .livemap:global(.is-live) .dot:after {
    content: "";
    border: 1.5px solid var(--color-green);
    border-radius: 50%;
    animation: ping 2.2s var(--ease-out) infinite;
    position: absolute;
    inset: -1px;
  }
  @keyframes ping {
    0% {
      opacity: .9;
      transform: scale(1);
    }
    70%,
    to {
      opacity: 0;
      transform: scale(3.2);
    }
  }
  .livemap-noscript a {
    color: var(--color-blue-strong);
    font-family: var(--font-mono);
    text-decoration: underline;
  }
  @media (width <= 720px) {
    .livemap-logo :global(img) {
      width: 120px;
    }
    .livemap-caption {
      font-size: .8125rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .livemap:global(.is-live) .dot:after {
      display: none;
    }
    .livemap:global(.is-active) .busy {
      animation-duration: 3.4s !important;
    }
  }
</style>
