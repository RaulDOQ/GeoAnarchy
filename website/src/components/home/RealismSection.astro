---
// "Realismo": no server shop and no teleport. The figure shows part of the server's
// real map with one long journey drawn on it: by sea, across a desert and over
// mountains. The map is always the real one: a photograph of that part of it, which the
// Worker takes and keeps (so it is there when the live map is down), and on top the
// map's own tiles when the page may use them. scripts/map-still.ts looks after both.
import SectionHead from './SectionHead.astro';
import generated from '../../generated/map-view.json';
import { drawableTiles, site, type MapView } from '../../config/site';
import { pt } from '../../content/pt';

const c = pt.realism;
const tiles = drawableTiles(generated as MapView);

// The cut, in cells of 2.5 degrees: 75°W to 45°E, 60°N to 30°S.
const crop = site.journey;
// The journey, in cells of the cut: north-east Brazil, the Atlantic, West Africa, the
// Sahara, the Mediterranean, the Alps, central Europe.
const route: [number, number][] = [
  [14.5, 27.5],
  [23.5, 16.5],
  [29.5, 13.5],
  [32.5, 9.5],
  [33.5, 5.5],
  [36.5, 3.5],
];
const start = route[0];
const end = route[route.length - 1];
const points = route.map(([x, y]) => `${x},${y}`).join(' ');
const at = (x: number, y: number) => `left: ${((x / crop.w) * 100).toFixed(2)}%; top: ${((y / crop.h) * 100).toFixed(2)}%`;
// The same cut as fractions of the whole world.
const { width: mapWidth, height: mapHeight } = site.grid;
const region = [crop.x / mapWidth, crop.y / mapHeight, (crop.x + crop.w) / mapWidth, (crop.y + crop.h) / mapHeight];
---

<section class="stage" id="realismo">
  <div class="container">
    <SectionHead num="03" chapter={c.chapter} title={c.title} lead={c.lead} />

    <div class="split">
      <div class="points">
        {
          c.points.map((point, i) => (
            <div class="point" data-in="settle" style={`--d: ${100 + i * 70}ms`}>
              <p class="mono-label">{point.label}</p>
              <p class="body">{point.body}</p>
            </div>
          ))
        }
        <p class="commands" data-in="settle" style="--d: 240ms">
          <span class="mono-label">{c.commandsLabel}</span>
          {c.commands.map((command) => <s>{command}</s>)}
        </p>
      </div>

      <figure
        class="journey"
        data-in="settle"
        data-map-still
        data-tiles={tiles ? JSON.stringify(tiles) : undefined}
        data-region={region.join(',')}
        data-snapshot-info="/api/map-snapshot.json"
        style={`--d: 140ms; --rx: ${region[0]}; --ry: ${region[1]}; --rw: ${region[2] - region[0]}; --rh: ${region[3] - region[1]}`}
      >
        <div class="journey-map" role="img" aria-label={c.route.label} style={`aspect-ratio: ${crop.w} / ${crop.h}`}>
          {/* The newest photograph of this part of the map. If there is none yet, the
              script puts the whole-world picture here instead, enlarged. */}
          <img class="still-photo" data-still-photo src="/api/map-journey/latest.jpg" alt="" loading="lazy" decoding="async" />
          <canvas class="still-tiles" data-still-tiles aria-hidden="true"></canvas>
          <svg class="route" viewBox={`0 0 ${crop.w} ${crop.h}`} preserveAspectRatio="none" aria-hidden="true">
            <polyline class="under" points={points}></polyline>
            <polyline class="over" points={points}></polyline>
            {route.slice(1, -1).map(([x, y]) => <rect class="stop" x={x - 0.3} y={y - 0.3} width=".6" height=".6" />)}
            <rect class="end" x={start[0] - 0.55} y={start[1] - 0.55} width="1.1" height="1.1"></rect>
            <rect class="end" x={end[0] - 0.55} y={end[1] - 0.55} width="1.1" height="1.1"></rect>
          </svg>
          <span class="tag right" style={at(13.4, 27.5)} aria-hidden="true">{c.route.from}</span>
          <span class="tag" style={at(19, 22)} aria-hidden="true">{c.route.sea}</span>
          <span class="tag" style={at(26.5, 15)} aria-hidden="true">{c.route.desert}</span>
          <span class="tag right" style={at(32.6, 5.5)} aria-hidden="true">{c.route.mountains}</span>
          <span class="tag left strong" style={at(37.6, 3.5)} aria-hidden="true">{c.route.to}</span>
        </div>
      </figure>
    </div>
  </div>
</section>

<script>
  import { initMapStill } from '../../scripts/map-still';
  document.querySelectorAll<HTMLElement>('[data-map-still]').forEach(initMapStill);
</script>

<style>
  .split {
    grid-template-columns: minmax(0, .82fr) minmax(0, 1.18fr);
    align-items: start;
    gap: 1rem;
    display: grid;
  }
  .points {
    gap: 1rem;
    display: grid;
  }
  .point {
    background: var(--grad-surface);
    box-shadow: var(--edge), var(--shadow-card);
    border-radius: var(--radius-xl);
    gap: .8rem;
    padding: 1.6rem 1.6rem 1.7rem;
    display: grid;
  }
  .point .mono-label {
    color: var(--color-blue-strong);
  }
  .body {
    color: var(--color-text-soft);
    letter-spacing: -.01em;
    font-size: 1.0625rem;
    line-height: 1.55;
  }
  /* Teleport commands, crossed out. */
  .commands {
    flex-wrap: wrap;
    align-items: center;
    gap: .5rem;
    padding: .5rem .35rem 0;
    display: flex;
  }
  .commands .mono-label {
    margin-right: .35rem;
  }
  s {
    box-shadow: var(--edge);
    color: var(--color-text-muted);
    font: 500 .8125rem/1 var(--font-mono);
    background: var(--color-surface-2);
    border-radius: 999px;
    padding: .45rem .7rem;
    text-decoration: line-through var(--color-text) 1.5px;
  }
  .journey {
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-window);
    overflow: hidden;
  }
  /* The sea's own blue, for the moment before the map arrives. */
  .journey-map {
    background: #1c3d78;
    position: relative;
    overflow: hidden;
  }
  /* A photograph of this part of the map, then the map's own tiles. Each fades in when
     it has arrived. */
  .still-photo,
  .still-tiles {
    width: 100%;
    height: 100%;
    transition: opacity .6s ease-out;
    position: absolute;
    inset: 0;
  }
  .still-photo {
    object-fit: cover;
    max-width: none;
  }
  .still-tiles,
  :global(.js) .still-photo {
    opacity: 0;
  }
  /* Until that photograph exists, the whole-world picture stands in: enlarged, so that
     only this part of it is in the frame. */
  .journey:global(.cuts-world) .still-photo {
    width: calc(100% / var(--rw));
    height: calc(100% / var(--rh));
    top: calc(var(--ry) / var(--rh) * -100%);
    left: calc(var(--rx) / var(--rw) * -100%);
  }
  :global(.js) .journey:global(.has-photo) .still-photo,
  .journey:global(.has-tiles) .still-tiles {
    opacity: 1;
  }
  .route {
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
  }
  .route polyline {
    fill: none;
    stroke-linejoin: round;
  }
  .under {
    stroke: var(--color-ink);
    stroke-opacity: .45;
    stroke-width: .62px;
  }
  .over {
    stroke: #fff;
    stroke-width: .26px;
    stroke-dasharray: .8 .55;
  }
  .stop {
    fill: #fff;
    stroke: var(--color-ink);
    stroke-width: .12px;
  }
  .end {
    fill: #fff;
    stroke: var(--color-ink);
    stroke-width: .2px;
  }
  .tag {
    color: var(--color-text);
    font: 500 .6875rem/1 var(--font-mono);
    letter-spacing: .06em;
    text-transform: uppercase;
    white-space: nowrap;
    background: #fff;
    border-radius: .4rem;
    padding: .4rem .55rem;
    position: absolute;
    transform: translate(-50%, -50%);
    box-shadow: 0 6px 14px -6px #0a1b2e80;
  }
  .tag.right {
    transform: translate(-100%, -50%);
  }
  .tag.left {
    transform: translate(0, -50%);
  }
  .tag.strong {
    color: #fff;
    background: var(--color-ink);
  }
  @media (prefers-reduced-motion: no-preference) {
    .over {
      animation: march 1.6s linear infinite;
    }
    @keyframes march {
      to {
        stroke-dashoffset: -1.35px;
      }
    }
  }
  @media (width <= 900px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
    }
    .journey {
      margin-top: .75rem;
    }
  }
  @media (width <= 560px) {
    .point {
      padding: 1.3rem;
    }
    .body {
      font-size: 1rem;
    }
    .tag {
      font-size: .5625rem;
      padding: .3rem .4rem;
    }
  }
</style>
