---
// Hero: the pitch and the two ways in on the left, the logo (the block Earth with the
// name) large on the right. The live map comes right under it, as the first section.
import Icon from '../Icon.astro';
import Logo from '../Logo.astro';
import { site } from '../../config/site';
import { pt } from '../../content/pt';

const c = pt.hero;
---

<section class="hero-wrap" id="inicio" aria-labelledby="hero-title">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="hero container">
    <div class="hero-copy">
    <a class="announce" href="#mapa" data-in="settle">
      <span><i></i>{c.announceTag}</span>
      {c.announce}
      <Icon name="arrowDown" />
    </a>
    <h1 id="hero-title" class="hero-title" data-in="lines" style="--d: 80ms">
      <span class="line"><span class="grad">{c.title[0]}</span></span>
      <span class="line"><span class="grad-earth">{c.title[1]}</span></span>
    </h1>
    <p class="hero-lead" data-in="settle" style="--d: 260ms">{c.lead}</p>
    <div class="hero-cta" data-in="settle" style="--d: 360ms">
      <button class="btn-solid ip" type="button" data-copy={site.java.address}>
        <span class="idle"><Icon name="copy" />{c.ctaCopy}<code>{site.java.address}</code></span>
        <span class="done" aria-hidden="true"><Icon name="check" />{pt.common.copied}</span>
      </button>
      <a class="btn-line" href={site.map.url} target="_blank" rel="noopener">{c.ctaMap}<Icon name="arrowRight" class="arrow" /></a>
    </div>
    <p class="hero-meta" data-in="dissolve" style="--d: 520ms">
      {c.facts.map((fact, i) => <span>{fact}{i < c.facts.length - 1 && ' ·'}</span>)}
    </p>
    </div>
    <div class="hero-logo" data-in="dissolve" style="--d: 120ms">
      <div class="hero-light" aria-hidden="true"></div>
      <span class="hero-logo-shadow" aria-hidden="true"></span>
      <div class="hero-logo-float"><Logo height={470} alt={site.name} /></div>
    </div>
    <div class="hero-next-wrap">
      <a class="hero-next" href="#mapa"><span class="num">01</span>{c.next}<Icon name="arrowDown" /></a>
    </div>
  </div>
</section>

<style>
  .hero-wrap {
    position: relative;
    overflow-x: clip;
  }
  .hero {
    min-height: calc(100svh - var(--nav-offset) - 2.25rem);
    grid-template-columns: minmax(0, 1fr) minmax(0, 30rem);
    align-items: center;
    gap: 3.5rem;
    padding-block: 2.5rem 4.5rem;
    display: grid;
    position: relative;
  }
  /* A faint chart grid behind the hero, fading out towards the edges. */
  .hero-bg {
    pointer-events: none;
    background-image: radial-gradient(#0a1b2e1f 1px, #0000 1.2px);
    background-position: 50% 0;
    background-size: 26px 26px;
    position: absolute;
    inset: -6rem 0 0;
    -webkit-mask-image: radial-gradient(60rem 34rem at 62% 38%, #000, #0000 78%);
    mask-image: radial-gradient(60rem 34rem at 62% 38%, #000, #0000 78%);
  }
  .hero-copy {
    z-index: 2;
    position: relative;
  }
  /* The logo, large, drifting gently up and down over a soft light. */
  .hero-logo {
    place-items: center;
    display: grid;
    position: relative;
  }
  .hero-light {
    pointer-events: none;
    background:
      radial-gradient(closest-side at 40% 42%, #1766e02e, #1766e00d 55%, #0000),
      radial-gradient(closest-side at 68% 66%, #12a05c29, #12a05c0a 55%, #0000);
    position: absolute;
    inset: -18% -26%;
  }
  .hero-logo-float {
    filter: drop-shadow(0 26px 30px #0a2a5c40);
    position: relative;
  }
  .hero-logo-float :global(img) {
    width: auto;
    max-width: 100%;
    height: clamp(17rem, 9rem + 20vw, 29.5rem);
  }
  .hero-logo-shadow {
    filter: blur(22px);
    opacity: .55;
    background: radial-gradient(closest-side, #0a2a5c59, #0a2a5c00);
    width: 62%;
    height: 2.6rem;
    position: absolute;
    bottom: -1.9rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-logo-float {
      animation: logo-float 7s var(--ease-in-out) infinite;
    }
    .hero-logo-shadow {
      animation: logo-shadow 7s var(--ease-in-out) infinite;
    }
    @keyframes logo-float {
      50% {
        transform: translateY(-12px) rotate(-1.2deg);
      }
    }
    @keyframes logo-shadow {
      50% {
        opacity: .38;
        transform: scale(.9);
      }
    }
  }
  .announce {
    height: 2rem;
    box-shadow: var(--edge), 0 2px 6px -3px #0a1b2e2e;
    color: var(--color-text-soft);
    background: var(--color-surface);
    border-radius: 999px;
    align-items: center;
    gap: .6rem;
    padding: 0 .75rem 0 .25rem;
    font-size: .84375rem;
    font-weight: 500;
    transition: background-color .2s, box-shadow .2s;
    display: inline-flex;
  }
  .announce:hover {
    background: var(--color-surface-2);
    box-shadow: var(--edge-strong), 0 2px 6px -3px #0a1b2e2e;
  }
  .announce > span {
    color: var(--color-green-strong);
    background: var(--color-green-soft);
    border-radius: 999px;
    align-items: center;
    gap: .4rem;
    padding: .25rem .6rem .25rem .5rem;
    font-size: .75rem;
    font-weight: 600;
    display: inline-flex;
  }
  .announce > span i {
    background: var(--color-green);
    border-radius: 50%;
    width: 6px;
    height: 6px;
  }
  .announce :global(svg) {
    color: var(--color-text-faint);
    stroke-width: 2.2px;
    width: .8rem;
    height: .8rem;
    transition: transform .4s var(--spring-snappy);
  }
  .announce:hover :global(svg) {
    transform: translateY(2px);
  }
  .hero-title {
    letter-spacing: -.045em;
    margin-top: 1.75rem;
    font-size: clamp(3.2rem, 1.3rem + 4.2vw, 4.6rem);
    font-weight: 600;
    line-height: 1;
  }
  .hero-lead {
    color: var(--color-text-muted);
    letter-spacing: -.012em;
    max-width: 31rem;
    margin-top: 1.5rem;
    font-size: 1.15rem;
    line-height: 1.55;
  }
  .hero-cta {
    flex-wrap: wrap;
    gap: .625rem;
    margin-top: 2.25rem;
    display: flex;
  }
  .hero-cta > * {
    min-height: 2.875rem;
  }
  /* The copy button: "Copiar IP geoanarchy.net", swapped for "Copiado" for a moment. */
  .ip {
    padding-right: .5rem;
    display: inline-grid;
  }
  .ip > span {
    grid-area: 1 / 1;
    justify-content: center;
    align-items: center;
    gap: .5rem;
    transition: opacity .2s, transform .35s var(--spring-snappy);
    display: inline-flex;
  }
  .ip code {
    font: 500 .8125rem/1 var(--font-mono);
    letter-spacing: -.01em;
    background: #ffffff29;
    border-radius: .45rem;
    margin-left: .25rem;
    padding: .45rem .55rem;
    box-shadow: inset 0 0 0 1px #ffffff2e;
  }
  .ip .done {
    opacity: 0;
    transform: translateY(6px);
  }
  .ip:global(.is-copied) .idle {
    opacity: 0;
    transform: translateY(-6px);
  }
  .ip:global(.is-copied) .done {
    opacity: 1;
    transform: none;
  }
  .hero-meta {
    color: var(--color-text-faint);
    font: 500 .75rem/1.5 var(--font-mono);
    letter-spacing: .02em;
    flex-wrap: wrap;
    gap: 0 .5em;
    margin-top: 1.9rem;
    display: flex;
  }
  .hero-meta span {
    white-space: nowrap;
  }
  .hero-next-wrap {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    translate: -50%;
  }
  .hero-next {
    color: var(--color-text-muted);
    white-space: nowrap;
    border-radius: .6rem;
    align-items: center;
    gap: .55rem;
    padding: .4rem .7rem .4rem .45rem;
    font-size: .8125rem;
    font-weight: 500;
    transition: color .2s, background-color .2s;
    display: inline-flex;
  }
  .hero-next:hover {
    color: var(--color-text);
    background: #0a1b2e0a;
  }
  .hero-next .num {
    min-width: 1.6rem;
    height: 1.25rem;
    box-shadow: inset 0 0 0 1px var(--color-blue-ring);
    color: var(--color-blue-strong);
    font: 500 .65625rem/1 var(--font-mono);
    background: var(--color-blue-soft);
    border-radius: .35rem;
    place-items: center;
    display: inline-grid;
  }
  .hero-next :global(svg) {
    width: .85rem;
    height: .85rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-next {
      animation: .7s ease-out 1.1s both next-in;
    }
    .hero-next :global(svg) {
      animation: next-nudge 2.6s var(--ease-in-out) 2.4s infinite;
    }
    @keyframes next-in {
      0% {
        opacity: 0;
        transform: translateY(6px);
      }
    }
    @keyframes next-nudge {
      0%,
      60%,
      to {
        transform: none;
      }
      30% {
        transform: translateY(3px);
      }
    }
  }
  @media (width <= 1100px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
      min-height: 0;
      padding-block: 2.5rem 5rem;
    }
    /* On narrow screens the logo comes first, smaller. */
    .hero-logo {
      order: -1;
    }
    .hero-logo-float :global(img) {
      height: clamp(13rem, 8rem + 16vw, 19rem);
    }
    .hero-light {
      inset: -10% 0;
    }
    .hero-next-wrap {
      display: none;
    }
  }
  @media (width <= 720px) {
    .hero {
      gap: 2rem;
      padding-block: 1.75rem 3rem;
    }
    .hero-title {
      font-size: clamp(2.5rem, 1.5rem + 6vw, 3.4rem);
    }
    .hero-lead {
      font-size: 1.05rem;
    }
  }
</style>
