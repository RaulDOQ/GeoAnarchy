---
// Hero: the pitch on the left, the live map of the server on the right.
import Icon from '../Icon.astro';
import LiveMap from './LiveMap.astro';
import { site } from '../../config/site';
import { pt } from '../../content/pt';

const c = pt.hero;
---

<section class="hero-wrap" id="inicio" aria-labelledby="hero-title">
  <div class="hero container">
    <div class="hero-copy">
      <p class="hero-facts mono-label" data-in="dissolve">
        {c.facts.map((fact, i) => <span>{i > 0 && <i aria-hidden="true">/</i>}{fact}</span>)}
      </p>
      <h1 id="hero-title" class="hero-title" data-in="lines" style="--d: 80ms">
        <span class="line"><span>{c.title[0]}</span></span>
        <span class="line"><span class="accent">{c.title[1]}</span></span>
      </h1>
      <p class="hero-lead" data-in="settle" style="--d: 260ms">{c.lead}</p>
      <div class="hero-cta" data-in="settle" style="--d: 360ms">
        <button class="btn-solid ip" type="button" data-copy={site.java.address}>
          <span class="idle"><Icon name="copy" />{c.ctaCopy}<code>{site.java.address}</code></span>
          <span class="done" aria-hidden="true"><Icon name="check" />{pt.common.copied}</span>
        </button>
        <a class="btn-line" href={site.map.url} target="_blank" rel="noopener">{c.ctaMap}<Icon name="arrowRight" class="arrow" /></a>
      </div>
    </div>
    <div class="hero-map" data-in="dissolve" style="--d: 120ms">
      <LiveMap />
    </div>
    <div class="hero-next-wrap">
      <a class="hero-next" href="#anarquia"><span class="num">01</span>{c.next}<Icon name="arrowDown" /></a>
    </div>
  </div>
</section>

<style>
  .hero-wrap {
    position: relative;
    overflow-x: clip;
  }
  .hero {
    min-height: calc(100svh - var(--nav-offset) - 2.25rem);
    grid-template-columns: minmax(0, 1fr) minmax(0, 34.5rem);
    align-items: center;
    gap: 3.5rem;
    padding-block: 2.5rem 4.5rem;
    display: grid;
    position: relative;
  }
  .hero-copy {
    z-index: 2;
    position: relative;
  }
  .hero-facts {
    color: var(--color-text-muted);
    flex-wrap: wrap;
    gap: .35rem .7rem;
    font-size: .75rem;
    display: flex;
  }
  .hero-facts span {
    white-space: nowrap;
    gap: .7rem;
    display: inline-flex;
  }
  .hero-facts i {
    color: var(--blue);
    font-style: normal;
  }
  .hero-title {
    letter-spacing: -.05em;
    margin-top: 1.4rem;
    font-size: clamp(3.3rem, 1.2rem + 4.8vw, 5.1rem);
    font-weight: 700;
    line-height: .98;
  }
  .hero-lead {
    color: var(--color-text-muted);
    letter-spacing: -.012em;
    max-width: 32rem;
    margin-top: 1.6rem;
    font-size: 1.15rem;
    line-height: 1.55;
  }
  .hero-cta {
    flex-wrap: wrap;
    gap: .625rem;
    margin-top: 2.25rem;
    display: flex;
  }
  .hero-cta > * {
    min-height: 3rem;
  }
  /* The copy button: "Copiar IP geoanarchy.net", swapped for "Copiado" for a moment. */
  .ip {
    padding-right: .5rem;
    display: inline-grid;
  }
  .ip > span {
    grid-area: 1 / 1;
    justify-content: center;
    align-items: center;
    gap: .55rem;
    transition: opacity .2s, transform .35s var(--spring-snappy);
    display: inline-flex;
  }
  .ip code {
    font: 500 .8125rem/1 var(--font-mono);
    letter-spacing: -.01em;
    background: var(--blue-strong);
    border-radius: .3rem;
    margin-left: .25rem;
    padding: .5rem .55rem;
  }
  .ip:hover code {
    background: #0c479f;
  }
  .ip .done {
    opacity: 0;
    transform: translateY(6px);
  }
  .ip:global(.is-copied) .idle {
    opacity: 0;
    transform: translateY(-6px);
  }
  .ip:global(.is-copied) .done {
    opacity: 1;
    transform: none;
  }
  .hero-map {
    display: grid;
    position: relative;
  }
  .hero-next-wrap {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    translate: -50%;
  }
  .hero-next {
    color: var(--color-text-muted);
    font: 500 .75rem/1 var(--font-mono);
    letter-spacing: .09em;
    text-transform: uppercase;
    white-space: nowrap;
    align-items: center;
    gap: .7rem;
    padding: .5rem .6rem;
    transition: color .2s;
    display: inline-flex;
  }
  .hero-next:hover {
    color: var(--ink);
  }
  .hero-next .num {
    color: var(--blue);
  }
  .hero-next :global(svg) {
    width: .85rem;
    height: .85rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-next {
      animation: .7s ease-out 1.1s both next-in;
    }
    .hero-next :global(svg) {
      animation: next-nudge 2.6s var(--ease-in-out) 2.4s infinite;
    }
    @keyframes next-in {
      0% {
        opacity: 0;
        transform: translateY(6px);
      }
    }
    @keyframes next-nudge {
      0%,
      60%,
      to {
        transform: none;
      }
      30% {
        transform: translateY(3px);
      }
    }
  }
  @media (width <= 1100px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 3rem;
      min-height: 0;
      padding-block: 3rem 5rem;
    }
    .hero-map {
      max-width: 42rem;
      width: 100%;
      margin-inline: auto;
    }
    .hero-next-wrap {
      display: none;
    }
  }
  @media (width <= 720px) {
    .hero {
      gap: 2.5rem;
      padding-block: 1.75rem 3rem;
    }
    .hero-title {
      font-size: clamp(2.7rem, 1.5rem + 6.4vw, 3.5rem);
    }
    .hero-lead {
      font-size: 1.05rem;
    }
  }
</style>
