---
// The idea of the server in one picture: three made-up countries, one alliance (the
// shared border of A and B) and one war (C marches on B). `compact` is the phone
// version: a tighter crop, bigger tags and no country names.
interface Props {
  label: string;
  compact?: boolean;
}

const { label, compact = false } = Astro.props;
const id = compact ? 'borders-c' : 'borders';
const tag = compact ? { w: 150, h: 46, r: 23, text: 6 } : { w: 84, h: 26, r: 13, text: 4 };
const war = compact ? { w: 136, y: 96 } : { w: 78, y: 108 };
---

<svg class:list={['borders-svg', { compact }]} viewBox={compact ? '180 26 900 276' : '0 0 1160 320'} preserveAspectRatio="xMidYMid slice" role="img" aria-label={label}>
  <defs>
    <pattern id={`${id}-grid`} width="58" height="53.333" patternUnits="userSpaceOnUse">
      <path d="M58 0H0V53.333" fill="none" stroke="#0a1b2e" stroke-opacity=".07"></path>
    </pattern>
    <marker id={`${id}-arrow`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M1 1.5 8 5 1 8.5" fill="none" stroke="#0a1b2e" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
    </marker>
  </defs>
  <rect width="1160" height="320" fill={`url(#${id}-grid)`}></rect>
  <g stroke-linejoin="round">
    <path class="land a" d="M232 96 372 62l88 58-22 110-150 34-98-62Z"></path>
    <path class="land b" d="M460 120 598 84l96 70-40 104-142 22-74-50Z"></path>
    <path class="land c" d="M838 98 986 78l76 86-58 92-150-8-70-82Z"></path>
  </g>
  <path class="ally" d="M460 120 438 230"></path>
  <path class="war" d="M800 150C760 128 728 128 700 146" marker-end={`url(#${id}-arrow)`}></path>
  <g class="pins">
    <g transform="translate(318 158)"><path d="M0 16V-12"></path><path class="f a" d="M0-12h20l-5 6 5 6H0Z"></path></g>
    <g transform="translate(566 172)"><path d="M0 16V-12"></path><path class="f b" d="M0-12h20l-5 6 5 6H0Z"></path></g>
    <g transform="translate(914 166)"><path d="M0 16V-12"></path><path class="f c" d="M0-12h20l-5 6 5 6H0Z"></path></g>
  </g>
  {
    !compact && (
      <g class="labels">
        <text x="318" y="204">PAÍS A</text>
        <text x="566" y="218">PAÍS B</text>
        <text x="914" y="212">PAÍS C</text>
      </g>
    )
  }
  <g class="tags">
    <g transform={`translate(449 ${compact ? 236 : 175})`}>
      <rect class="t ally-t" x={-tag.w / 2} y={-tag.h / 2} width={tag.w} height={tag.h} rx={tag.r}></rect>
      <text y={tag.text + (compact ? 2 : 0)}>ALIANÇA</text>
    </g>
    <g transform={`translate(750 ${war.y})`}>
      <rect class="t war-t" x={-war.w / 2} y={-tag.h / 2} width={war.w} height={tag.h} rx={tag.r}></rect>
      <text y={tag.text + (compact ? 2 : 0)}>GUERRA</text>
    </g>
  </g>
</svg>

<style>
  .borders-svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .land {
    stroke-width: 2px;
  }
  .land.a {
    fill: #1766e01f;
    stroke: #1766e0;
  }
  .land.b {
    fill: #12a05c24;
    stroke: #12a05c;
  }
  .land.c {
    fill: #0a1b2e0d;
    stroke: #0a1b2e80;
  }
  .ally {
    fill: none;
    stroke: #fff;
    stroke-width: 5px;
    stroke-linecap: round;
  }
  .war {
    fill: none;
    stroke: #0a1b2e;
    stroke-width: 2px;
    stroke-linecap: round;
    stroke-dasharray: 2 7;
  }
  .pins path {
    fill: none;
    stroke: #0a1b2e;
    stroke-width: 2px;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pins .f.a {
    fill: #1766e0;
    stroke: #1766e0;
  }
  .pins .f.b {
    fill: #12a05c;
    stroke: #12a05c;
  }
  .pins .f.c {
    fill: #0a1b2e;
  }
  text {
    font: 500 11px var(--font-mono);
    letter-spacing: .08em;
    text-anchor: middle;
  }
  .labels text {
    fill: #0a1b2eb3;
  }
  .tags .t {
    fill: #fff;
    stroke-width: 1px;
  }
  .tags .ally-t {
    stroke: #12a05c80;
  }
  .tags .war-t {
    stroke: #0a1b2e59;
  }
  .tags text {
    fill: #0a1b2e;
    font-size: 10.5px;
  }
  .compact .land,
  .compact .war,
  .compact .pins path {
    stroke-width: 3px;
  }
  .compact .ally {
    stroke-width: 7px;
  }
  .compact .tags text {
    font-size: 21px;
  }
  .compact .tags .t {
    stroke-width: 1.5px;
  }
</style>
