---
// "Como entrar": the addresses for Java and Bedrock, each with a copy button, and the
// three steps to connect.
import CopyField from '../CopyField.astro';
import SectionHead from './SectionHead.astro';
import { site } from '../../config/site';
import { pt } from '../../content/pt';

const c = pt.join;
---

<section class="stage" id="entrar">
  <div class="container">
    <SectionHead num="04" chapter={c.chapter} title={c.title} lead={c.lead} />

    <div class="editions">
      <article class="edition" data-in="settle" style="--d: 100ms">
        <header>
          <h3>{c.java.name}</h3>
          <p>{c.java.note}</p>
        </header>
        <div class="fields">
          <CopyField label={c.java.addressLabel} value={site.java.address} />
        </div>
        <ol>
          {c.java.steps.map((step) => <li>{step}</li>)}
        </ol>
      </article>

      <article class="edition" data-in="settle" style="--d: 170ms">
        <header>
          <h3>{c.bedrock.name}</h3>
          <p>{c.bedrock.note}</p>
        </header>
        <div class="fields two">
          <CopyField label={c.bedrock.addressLabel} value={site.bedrock.address} />
          <CopyField label={c.bedrock.portLabel} value={String(site.bedrock.port)} />
        </div>
        <ol>
          {c.bedrock.steps.map((step) => <li>{step}</li>)}
        </ol>
      </article>
    </div>
  </div>
</section>

<style>
  /* Two columns that share one frame, split by a rule. */
  .editions {
    border: 1px solid var(--ink);
    border-radius: var(--radius-panel);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    display: grid;
    overflow: hidden;
  }
  .edition {
    align-content: start;
    gap: 1.5rem;
    padding: 1.9rem;
    display: grid;
  }
  .edition + .edition {
    border-left: 1px solid var(--ink);
  }
  header {
    gap: .45rem;
    display: grid;
  }
  h3 {
    letter-spacing: -.03em;
    font-size: 1.5rem;
  }
  header p {
    color: var(--color-text-muted);
    font: 400 .78125rem/1.4 var(--font-mono);
    letter-spacing: -.01em;
  }
  .fields {
    gap: .6rem;
    display: grid;
  }
  .fields.two {
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
  }
  ol {
    counter-reset: step;
    border-top: 1px solid var(--line-strong);
    list-style: none;
  }
  li {
    counter-increment: step;
    border-bottom: 1px solid var(--line-strong);
    color: var(--color-text-soft);
    align-items: baseline;
    gap: 1rem;
    padding: .8rem 0;
    font-size: .9375rem;
    line-height: 1.4;
    display: flex;
  }
  li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  li:before {
    content: "0" counter(step);
    color: var(--blue);
    font: 500 .75rem/1 var(--font-mono);
    flex: none;
  }
  @media (width <= 900px) {
    .editions {
      grid-template-columns: minmax(0, 1fr);
    }
    .edition + .edition {
      border-top: 1px solid var(--ink);
      border-left: 0;
    }
  }
  @media (width <= 520px) {
    .edition {
      padding: 1.3rem;
    }
    .fields.two {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
