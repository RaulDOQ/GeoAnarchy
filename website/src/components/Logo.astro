---
// The GeoAnarchy mark: a globe on a blue-to-green tile.
interface Props {
  size?: number;
  /** Gradient ids must be unique on a page: pass a different one per use. */
  id?: string;
}

const { size = 28, id = 'ga-mark' } = Astro.props;
---

<svg class="logo" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <defs>
    <linearGradient id={id} x1="3" y1="3" x2="29" y2="29" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#3b86f5"></stop>
      <stop offset=".5" stop-color="#1766e0"></stop>
      <stop offset="1" stop-color="#12a05c"></stop>
    </linearGradient>
  </defs>
  <rect width="32" height="32" rx="9" fill={`url(#${id})`}></rect>
  <g fill="none" stroke="#fff" stroke-width="1.7" stroke-linecap="round">
    <circle cx="16" cy="16" r="8.6"></circle>
    <path d="M7.4 16h17.2"></path>
    <path d="M16 7.4c3.4 2.7 3.4 14.5 0 17.2"></path>
    <path d="M16 7.4c-3.4 2.7-3.4 14.5 0 17.2"></path>
  </g>
</svg>
