---
// The frame of every store page (/loja/ and the pages under it): the category tabs over
// the page's own content, and a column at the side with the monthly goal and where to
// hear when the store opens. On narrow screens the side column comes after the content.
// The categories are in src/config/store.ts; their names in pt.store.categories.
import Icon from '../Icon.astro';
import { site } from '../../config/site';
import { goalProgress, reais, store } from '../../config/store';
import { pt } from '../../content/pt';

interface Props {
  /** The id of the category this page shows ("vip", "tags"). */
  active: string;
}

const { active } = Astro.props;
const c = pt.store;
const g = c.goal;
const money = (centavos: number) => `R$ ${reais(centavos)}`;
const { goal } = store;
const progress = goalProgress(goal);
const goalOf = g.of.replace('{goal}', money(goal.amount));
// Under the bar: what is missing, or that the goal is reached (and by how much it was passed).
const goalStatus = progress.left > 0 ? g.left.replace('{left}', money(progress.left)) : progress.over > 0 ? `${g.reached} · ${g.over.replace('{over}', money(progress.over))}` : g.reached;
---

<section class="container store">
  <nav class="categories" aria-label={c.categoriesLabel} data-in="settle" style="--d: 20ms">
    {
      store.categories.map((category) => (
        <a href={category.path} aria-current={category.id === active ? 'page' : undefined}>
          {c.categories[category.id] ?? category.id}
        </a>
      ))
    }
  </nav>

  <div class="shop">
    <slot />
  </div>

  <aside class="side">
    <div class="goal card" data-in="settle" style="--d: 40ms">
      <p class="label">{g.label}</p>
      <p class="goal-amount">
        <span class="currency">R$</span>
        <strong>{reais(goal.raised)}</strong>
        <span class="per">{goalOf}</span>
      </p>
      <div
        class="bar"
        role="progressbar"
        aria-label={g.label}
        aria-valuemin="0"
        aria-valuemax={goal.amount / 100}
        aria-valuenow={Math.min(goal.raised, goal.amount) / 100}
        aria-valuetext={`${money(goal.raised)} ${goalOf}`}
      >
        <i class={progress.percent > 0 ? 'some' : undefined} style={`width: ${progress.percent.toFixed(2)}%`}></i>
      </div>
      <p class="goal-status">{goalStatus}</p>
      <p class="goal-text">{g.about}</p>
      <p class="goal-text">{g.beyond}</p>
    </div>

    <div class="status card" data-in="settle" style="--d: 100ms">
      <h2>{c.status.title}</h2>
      <p>{c.status.body}</p>
      <a class="btn-solid" href={site.discordUrl} target="_blank" rel="noopener">{c.cta}<Icon name="arrowUpRight" class="arrow" /></a>
    </div>
  </aside>
</section>

<style>
  /* The page's content on the left, the side column on the right, the tabs over the content. */
  .store {
    grid-template-columns: minmax(0, 1fr) 18.5rem;
    grid-template-areas:
      "tabs side"
      "shop side";
    grid-template-rows: auto 1fr;
    align-items: start;
    gap: 1.5rem 1.75rem;
    padding-top: 3rem;
    display: grid;
  }
  /* A container, so a page can lay its cards out by the width it really has. */
  .shop {
    container: shop / inline-size;
    grid-area: shop;
    min-width: 0;
  }

  /* The categories: one tab per page, the open one raised, like the period switch. */
  .categories {
    box-shadow: var(--edge);
    background: var(--color-surface-2);
    border-radius: 999px;
    grid-area: tabs;
    justify-self: start;
    gap: .2rem;
    max-width: 100%;
    padding: .3rem;
    display: inline-flex;
    overflow-x: auto;
  }
  .categories a {
    color: var(--color-text-muted);
    letter-spacing: -.01em;
    white-space: nowrap;
    border-radius: 999px;
    padding: .65rem 1.25rem;
    font-size: .9375rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    transition: color .2s, background-color .2s, box-shadow .2s;
  }
  .categories a:hover {
    color: var(--color-text);
  }
  .categories a[aria-current="page"] {
    color: var(--color-text);
    background: var(--color-surface);
    box-shadow: var(--edge), 0 3px 8px -4px #00000080;
  }
  .categories a:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  /* The side column stays in view while the content scrolls. */
  .side {
    grid-area: side;
    gap: 1rem;
    display: grid;
    position: sticky;
    top: calc(var(--nav-offset) + 1.25rem);
  }

  /* The monthly goal: the count, its bar, what is missing, and what it is for. */
  .goal {
    gap: .85rem;
    padding: 1.5rem 1.45rem 1.55rem;
    display: grid;
  }
  .goal-amount {
    flex-wrap: wrap;
    align-items: baseline;
    gap: .35rem .4rem;
    display: flex;
  }
  .currency {
    color: var(--color-text-soft);
    font-size: 1rem;
    font-weight: 600;
  }
  strong {
    font-variant-numeric: tabular-nums;
    letter-spacing: -.045em;
    font-size: 2.4rem;
    font-weight: 600;
    line-height: 1;
  }
  .per {
    color: var(--color-text-muted);
    font-size: .9375rem;
  }
  .bar {
    box-shadow: var(--edge-strong);
    background: var(--color-surface-2);
    border-radius: 999px;
    height: .7rem;
    overflow: hidden;
  }
  .bar i {
    background: var(--grad-earth);
    border-radius: inherit;
    height: 100%;
    transition: width 1.1s var(--ease-out) .35s;
    display: block;
  }
  /* A first small amount still shows as a rounded tip. */
  .bar i.some {
    min-width: .7rem;
  }
  :global(.js) .goal:not(:global(.is-in)) .bar i {
    width: 0 !important;
    min-width: 0;
  }
  .goal-status {
    color: var(--color-text-soft);
    font-size: .9375rem;
    font-weight: 600;
  }
  .goal-text {
    color: var(--color-text-muted);
    font-size: .9375rem;
    line-height: 1.55;
  }

  .status {
    align-content: start;
    gap: .55rem;
    padding: 1.4rem 1.45rem 1.5rem;
    display: grid;
  }
  .status h2 {
    letter-spacing: -.025em;
    font-size: 1.125rem;
  }
  .status p {
    color: var(--color-text-muted);
    font-size: .9375rem;
    line-height: 1.55;
  }
  .status .btn-solid {
    justify-self: start;
    margin-top: .35rem;
  }

  @media (width <= 1000px) {
    .store {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "tabs"
        "shop"
        "side";
    }
    .side {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
      position: static;
    }
  }
  @media (width <= 640px) {
    .side {
      grid-template-columns: minmax(0, 1fr);
    }
    .categories {
      display: flex;
      justify-self: stretch;
    }
    .categories a {
      text-align: center;
      flex: 1;
    }
  }
</style>
