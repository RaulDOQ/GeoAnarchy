---
// "GeoWiki", the players' wiki: its front page. The first three articles are here, on
// one page (how to join, the world, how the server works and its rules), followed by the way
// into the economy, countries, enchantments and VIP articles, which are pages of their own
// (src/content/wiki/jogador).
import WikiLayout from '../../components/wiki/WikiLayout.astro';
import WikiTopics from '../../components/wiki/WikiTopics.astro';
import Editions from '../../components/Editions.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../config/site';
import { wikiBase } from '../../config/wiki';
import { pt } from '../../content/pt';

const c = pt.wiki;
---

<WikiLayout wiki="jogador" title={c.meta.title} description={c.meta.description} current={wikiBase.jogador}>
  <div class="articles">
    <article id={c.join.id}>
      <h2 data-in="settle">{c.join.title}</h2>
      <p class="intro" data-in="settle" style="--d: 60ms">{c.join.intro}</p>
      <Editions />
    </article>

    <article id={c.world.id}>
      <h2 data-in="settle">{c.world.title}</h2>
      <p class="intro" data-in="settle" style="--d: 60ms">{c.world.intro}</p>
      <dl class="rows card" data-in="settle" style="--d: 100ms">
        {
          c.world.rows.map((row) => (
            <div>
              <dt>{row.label}</dt>
              <dd>{row.value}</dd>
            </div>
          ))
        }
      </dl>
      <a class="learn" href={site.map.url} target="_blank" rel="noopener" data-in="settle" style="--d: 140ms">{pt.world.open}<Icon name="arrowRight" /></a>
    </article>

    <article id={c.rules.id}>
      <h2 data-in="settle">{c.rules.title}</h2>
      <p class="intro" data-in="settle" style="--d: 60ms">{c.rules.intro}</p>
      <ul class="checks rules card" data-in="settle" style="--d: 100ms">
        {c.rules.items.map((item) => <li>{item}</li>)}
      </ul>
      <WikiTopics wiki="jogador" section="geral" />
    </article>

    <article id={c.economy.id}>
      <h2 data-in="settle">{c.economy.title}</h2>
      <p class="intro" data-in="settle" style="--d: 60ms">{c.economy.intro}</p>
      <WikiTopics wiki="jogador" section="economia" />
    </article>

    {
      [c.countries, c.enchantments, c.vip].map((part) => (
        <article id={part.id}>
          <h2 data-in="settle">{part.title}</h2>
          <p class="intro" data-in="settle" style="--d: 60ms">{part.intro}</p>
          <WikiTopics wiki="jogador" section={part.id} />
        </article>
      ))
    }
  </div>
</WikiLayout>

<style>
  .articles {
    gap: 4.5rem;
    display: grid;
  }
  article {
    justify-items: start;
    gap: 1rem;
    display: grid;
  }
  article > :global(*) {
    width: 100%;
  }
  h2 {
    letter-spacing: -.035em;
    font-size: clamp(1.75rem, 1.3rem + 1.4vw, 2.25rem);
  }
  .intro {
    color: var(--color-text-muted);
    max-width: 38rem;
    margin-bottom: .75rem;
    font-size: 1.0625rem;
    line-height: 1.6;
  }
  .rows {
    margin: 0;
    padding: .6rem;
    display: grid;
  }
  .rows div {
    border-radius: .7rem;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    padding: .8rem 1rem;
    display: flex;
  }
  .rows div:nth-child(odd) {
    background: var(--color-surface-2);
  }
  dt {
    color: var(--color-text-muted);
    font-size: .9375rem;
  }
  dd {
    font-variant-numeric: tabular-nums;
    text-align: right;
    font-size: .9375rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
  }
  article > .learn {
    width: auto;
    margin-top: .25rem;
  }
  .rules {
    gap: .9rem;
    padding: 1.5rem 1.6rem;
  }
  .rules :global(li) {
    font-size: 1rem;
  }
  @media (width <= 900px) {
    .articles {
      gap: 3.5rem;
    }
  }
</style>
