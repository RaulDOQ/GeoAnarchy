---
// "GeoWiki": the first three articles on one page, with an index beside them. They
// repeat what the home page says (how to join, the world, how the server works); more
// pages come later.
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Editions from '../../components/Editions.astro';
import Icon from '../../components/Icon.astro';
import Closing from '../../components/home/Closing.astro';
import { site } from '../../config/site';
import { pt } from '../../content/pt';

const c = pt.wiki;
const articles = [c.join, c.world, c.rules];
---

<Base title={c.meta.title} description={c.meta.description} page="wiki">
  <PageHead chapter={c.chapter} title={c.title} lead={c.lead} />

  <div class="container wiki">
    <nav class="index card" aria-label={c.indexLabel} data-in="settle">
      <p class="mono-label">{c.indexLabel}</p>
      {articles.map((article, i) => <a href={`#${article.id}`}><span>0{i + 1}</span>{article.title}</a>)}
      <p class="more">{pt.common.soon}</p>
    </nav>

    <div class="articles">
      <article id={c.join.id}>
        <h2 data-in="settle">{c.join.title}</h2>
        <p class="intro" data-in="settle" style="--d: 60ms">{c.join.intro}</p>
        <Editions />
      </article>

      <article id={c.world.id}>
        <h2 data-in="settle">{c.world.title}</h2>
        <p class="intro" data-in="settle" style="--d: 60ms">{c.world.intro}</p>
        <dl class="rows card" data-in="settle" style="--d: 100ms">
          {
            c.world.rows.map((row) => (
              <div>
                <dt>{row.label}</dt>
                <dd>{row.value}</dd>
              </div>
            ))
          }
        </dl>
        <a class="learn" href={site.map.url} target="_blank" rel="noopener" data-in="settle" style="--d: 140ms">{pt.world.open}<Icon name="arrowRight" /></a>
      </article>

      <article id={c.rules.id}>
        <h2 data-in="settle">{c.rules.title}</h2>
        <p class="intro" data-in="settle" style="--d: 60ms">{c.rules.intro}</p>
        <ul class="checks rules card" data-in="settle" style="--d: 100ms">
          {c.rules.items.map((item) => <li>{item}</li>)}
        </ul>
      </article>
    </div>
  </div>

  <Closing />
</Base>

<style>
  .wiki {
    grid-template-columns: 15rem minmax(0, 1fr);
    align-items: start;
    gap: 3rem;
    padding-top: 3.5rem;
    display: grid;
  }
  .index {
    top: calc(var(--nav-offset) + 1.5rem);
    gap: .15rem;
    padding: 1.1rem .6rem .9rem;
    display: grid;
    position: sticky;
  }
  .index .mono-label {
    padding: 0 .6rem .7rem;
  }
  .index a {
    color: var(--color-text-soft);
    border-radius: .55rem;
    align-items: baseline;
    gap: .7rem;
    padding: .55rem .6rem;
    font-size: .9375rem;
    font-weight: 500;
    transition: background-color .2s, color .2s;
    display: flex;
  }
  .index a:hover {
    color: var(--color-text);
    background: var(--color-surface-hover);
  }
  .index a span {
    color: var(--color-blue-strong);
    font: 500 .6875rem/1 var(--font-mono);
  }
  .more {
    color: var(--color-text-faint);
    padding: .6rem .6rem 0;
    font-size: .8125rem;
  }
  .articles {
    gap: 4.5rem;
    display: grid;
  }
  article {
    justify-items: start;
    gap: 1rem;
    display: grid;
  }
  article > :global(*) {
    width: 100%;
  }
  h2 {
    letter-spacing: -.035em;
    font-size: clamp(1.75rem, 1.3rem + 1.4vw, 2.25rem);
  }
  .intro {
    color: var(--color-text-muted);
    max-width: 38rem;
    margin-bottom: .75rem;
    font-size: 1.0625rem;
    line-height: 1.6;
  }
  .rows {
    margin: 0;
    padding: .6rem;
    display: grid;
  }
  .rows div {
    border-radius: .7rem;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    padding: .8rem 1rem;
    display: flex;
  }
  .rows div:nth-child(odd) {
    background: var(--color-surface-2);
  }
  dt {
    color: var(--color-text-muted);
    font-size: .9375rem;
  }
  dd {
    font: 500 .9375rem/1.3 var(--font-mono);
    letter-spacing: -.02em;
    text-align: right;
    margin: 0;
  }
  article > .learn {
    width: auto;
    margin-top: .25rem;
  }
  .rules {
    gap: .9rem;
    padding: 1.5rem 1.6rem;
  }
  .rules :global(li) {
    font-size: 1rem;
  }
  @media (width <= 900px) {
    .wiki {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }
    .index {
      position: static;
    }
    .articles {
      gap: 3.5rem;
    }
  }
</style>
