import WorldSection from '../components/home/WorldSection.astro';
import RealismSection from '../components/home/RealismSection.astro';
import JoinSection from '../components/home/JoinSection.astro';
import FaqSection from '../components/home/FaqSection.astro';
import Closing from '../components/home/Closing.astro';
import { pt } from '../content/pt';
---

<Base title={pt.meta.title} description={pt.meta.description} page="home">
