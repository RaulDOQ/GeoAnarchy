---
// "Loja": the three plans. A switch chooses how often to pay (every month, every 3
// months, every 6 months) and every card shows the price for that choice; it works
// without JavaScript. The plans cannot be bought yet, so the cards say "Em breve" and
// the page points to Discord for news. Plans and prices: src/config/store.ts.
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import Closing from '../../components/home/Closing.astro';
import { site } from '../../config/site';
import { periodPrice, reais, store } from '../../config/store';
import { pt } from '../../content/pt';

const c = pt.store;
const money = (centavos: number) => `R$ ${reais(centavos)}`;
---

<Base title={c.meta.title} description={c.meta.description} page="store">
  <PageHead chapter={c.chapter} title={c.title} lead={c.lead} />

  <section class="container store">
    <fieldset class="switch" data-in="settle" style="--d: 60ms">
      <legend class="visually-hidden">{c.periodLabel}</legend>
      {
        store.periods.map((period, i) => (
          <>
            <input class="visually-hidden" type="radio" name="period" id={`period-${i}`} checked={i === 0} />
            <label for={`period-${i}`}>
              {c.periods[i]}
              {period.off > 0 && <span class="off">−{period.off}%</span>}
            </label>
          </>
        ))
      }
    </fieldset>

    <ul class="plans">
      {
        store.plans.map((plan, i) => (
          <li class="plan card" data-in="settle" style={`--d: ${120 + i * 70}ms`}>
            <div class="plan-top">
              <h2>{plan.name}</h2>
              {/* One more block for every plan up. */}
              <span class="tier" aria-hidden="true">
                {store.plans.map((_, n) => (
                  <i class={n <= i ? 'on' : undefined} />
                ))}
              </span>
            </div>

            {
              store.periods.map((period, n) => {
                const price = periodPrice(plan.monthly, period);
                return (
                  <div class={`price p${n}`}>
                    <p class="amount">
                      <span class="currency">R$</span>
                      <strong>{reais(price.perMonth)}</strong>
                      <span class="per">{c.perMonth}</span>
                    </p>
                    <p class="billed">
                      {period.months === 1 ? (
                        c.billedMonthly
                      ) : (
                        <>
                          {c.billed.replace('{total}', money(price.total)).replace('{months}', String(period.months))}
                          <span class="was">
                            {c.instead.split('{full}')[0]}
                            <s>{money(price.full)}</s>
                          </span>
                        </>
                      )}
                    </p>
                  </div>
                );
              })
            }

            <div class="benefits">
              <p class="label">{c.benefitsLabel}</p>
              {c.benefits[plan.id]?.length ? (
                <ul class="checks">
                  {c.benefits[plan.id].map((benefit) => (
                    <li>{benefit}</li>
                  ))}
                </ul>
              ) : (
                <p class="later">{c.benefitsSoon}</p>
              )}
            </div>

            <p class="soon-tag">{pt.common.soon}</p>
          </li>
        ))
      }
    </ul>

    <div class="after">
      <div class="status card" data-in="settle" style="--d: 100ms">
        <div>
          <h2>{c.status.title}</h2>
          <p>{c.status.body}</p>
        </div>
        <a class="btn-solid" href={site.discordUrl} target="_blank" rel="noopener">{c.cta}<Icon name="arrowUpRight" class="arrow" /></a>
      </div>
      <div class="note card" data-in="settle" style="--d: 170ms">
        <h2>{c.note.title}</h2>
        <p>{c.note.body}</p>
      </div>
    </div>
  </section>

  <Closing />
</Base>

<style>
  .store {
    padding-top: 3rem;
  }

  /* How often to pay: three choices side by side, the chosen one raised. */
  .switch {
    box-shadow: var(--edge);
    background: var(--color-surface-2);
    border: 0;
    border-radius: 999px;
    gap: .2rem;
    min-width: 0;
    margin: 0;
    padding: .3rem;
    display: inline-flex;
    position: relative;
  }
  .switch label {
    color: var(--color-text-muted);
    letter-spacing: -.01em;
    white-space: nowrap;
    cursor: pointer;
    border-radius: 999px;
    align-items: center;
    gap: .5rem;
    padding: .6rem 1.05rem;
    font-size: .9375rem;
    font-weight: 600;
    line-height: 1;
    transition: color .2s, background-color .2s, box-shadow .2s;
    display: inline-flex;
  }
  .switch label:hover {
    color: var(--color-text);
  }
  .switch input:checked + label {
    color: var(--color-text);
    background: var(--color-surface);
    box-shadow: var(--edge), 0 3px 8px -4px #0a1b2e59;
  }
  .switch input:focus-visible + label {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .off {
    box-shadow: inset 0 0 0 1px var(--color-green-ring);
    color: var(--color-green-strong);
    font-variant-numeric: tabular-nums;
    background: var(--color-green-soft);
    border-radius: 999px;
    padding: .22rem .45rem;
    font-size: .75rem;
  }

  .plans {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
    list-style: none;
    display: grid;
  }
  .plan {
    grid-template-rows: auto auto 1fr auto;
    gap: 1.5rem;
    padding: 1.7rem 1.7rem 1.6rem;
    display: grid;
  }
  .plan-top {
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    display: flex;
  }
  h2 {
    letter-spacing: -.03em;
    font-size: 1.5rem;
  }
  .tier {
    gap: 3px;
    display: inline-flex;
  }
  .tier i {
    box-shadow: var(--edge-strong);
    background: var(--color-surface-2);
    border-radius: 2px;
    width: .65rem;
    height: .65rem;
  }
  .tier i.on {
    box-shadow: none;
    background: var(--color-blue);
  }
  .tier i.on:nth-child(2) {
    background: #0e8fb4;
  }
  .tier i.on:nth-child(3) {
    background: var(--color-green);
  }

  /* Every card holds the price for each way of paying; only the chosen one shows. */
  .price {
    gap: .7rem;
    display: none;
  }
  .store:has(#period-0:checked) .p0,
  .store:has(#period-1:checked) .p1,
  .store:has(#period-2:checked) .p2 {
    display: grid;
  }
  .amount {
    align-items: baseline;
    gap: .4rem;
    display: flex;
  }
  .currency {
    color: var(--color-text-soft);
    font-size: 1.125rem;
    font-weight: 600;
  }
  strong {
    font-variant-numeric: tabular-nums;
    letter-spacing: -.045em;
    font-size: clamp(2.6rem, 1.9rem + 1.6vw, 3.25rem);
    font-weight: 600;
    line-height: 1;
  }
  .per,
  .billed {
    color: var(--color-text-muted);
    font-size: .9375rem;
  }
  /* Two lines in every card, whatever the way of paying, so the cards stay aligned:
     what is charged, and under it what the same months cost without the discount. */
  .billed {
    min-height: 2.9em;
    line-height: 1.45;
  }
  .was {
    color: var(--color-text-faint);
    display: block;
  }

  .benefits {
    box-shadow: var(--edge);
    background: var(--color-bg-tint);
    border-radius: .9rem;
    align-content: start;
    gap: .6rem;
    padding: 1.05rem 1.15rem 1.15rem;
    display: grid;
  }
  .later {
    color: var(--color-text-muted);
    font-size: .9375rem;
    line-height: 1.5;
  }
  .soon-tag {
    box-shadow: inset 0 0 0 1px var(--color-green-ring);
    color: var(--color-green-strong);
    background: var(--color-green-soft);
    border-radius: 999px;
    justify-self: start;
    padding: .4rem .75rem;
    font-size: .8125rem;
    font-weight: 600;
    line-height: 1;
  }

  .after {
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 1rem;
    margin-top: 1rem;
    display: grid;
  }
  .status,
  .note {
    padding: 1.5rem 1.6rem;
  }
  .status {
    justify-content: space-between;
    align-items: center;
    gap: 1.25rem;
    display: flex;
  }
  .status div,
  .note {
    align-content: start;
    gap: .4rem;
    display: grid;
  }
  .after h2 {
    letter-spacing: -.025em;
    font-size: 1.1875rem;
  }
  .after p {
    color: var(--color-text-muted);
    font-size: .9375rem;
    line-height: 1.55;
  }

  /* A browser too old to follow the switch: show every price, each saying its period. */
  @supports not selector(:has(*)) {
    .switch {
      display: none;
    }
    .price {
      display: grid;
    }
  }

  @media (width <= 900px) {
    .plans,
    .after {
      grid-template-columns: minmax(0, 1fr);
    }
    .plan {
      gap: 1.25rem;
    }
  }
  @media (width <= 560px) {
    .switch {
      display: flex;
    }
    .switch label {
      flex: 1;
      justify-content: center;
      gap: .35rem;
      padding: .65rem .5rem;
      font-size: .875rem;
    }
    .status {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
