---
// "Loja": how to help pay for the server. First the monthly goal (what it takes to
// keep the server running, how much has come in and how much is missing), then the
// three plans. A switch chooses how often to pay (every month, every 3 months, every 6
// months) and every card shows the price for that choice; it works without JavaScript.
// The plans cannot be bought yet, so the cards say "Em breve" and the page points to
// Discord for news. The goal, the plans and the prices: src/config/store.ts.
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import Closing from '../../components/home/Closing.astro';
import { site } from '../../config/site';
import { goalProgress, periodPrice, reais, store } from '../../config/store';
import { pt } from '../../content/pt';

const c = pt.store;
const g = c.goal;
const money = (centavos: number) => `R$ ${reais(centavos)}`;
const { goal } = store;
const progress = goalProgress(goal);
const goalOf = g.of.replace('{goal}', money(goal.amount));
// Under the bar: what is missing, or that the goal is reached (and by how much it was passed).
const goalStatus = progress.left > 0 ? g.left.replace('{left}', money(progress.left)) : progress.over > 0 ? `${g.reached} · ${g.over.replace('{over}', money(progress.over))}` : g.reached;

// Painted words in a benefit: "{style|words}" becomes words in that style (see
// pt.store.benefits, and "Painted words" in the styles below).
interface Piece {
  style?: string;
  text: string;
}
function painted(text: string): Piece[] {
  const pieces: Piece[] = [];
  let last = 0;
  for (const match of text.matchAll(/\{([a-z-]+)\|([^}]+)\}/g)) {
    const at = match.index ?? 0;
    if (at > last) pieces.push({ text: text.slice(last, at) });
    pieces.push({ style: match[1], text: match[2] });
    last = at + match[0].length;
  }
  if (last < text.length) pieces.push({ text: text.slice(last) });
  return pieces;
}
---

<Base title={c.meta.title} description={c.meta.description} page="store">
  <PageHead chapter={c.chapter} title={c.title} lead={c.lead} />

  <section class="container store">
    <div class="goal card" data-in="settle" style="--d: 40ms">
      <div class="goal-count">
        <p class="label">{g.label}</p>
        <p class="amount">
          <span class="currency">R$</span>
          <strong>{reais(goal.raised)}</strong>
          <span class="per">{goalOf}</span>
        </p>
        <div
          class="bar"
          role="progressbar"
          aria-label={g.label}
          aria-valuemin="0"
          aria-valuemax={goal.amount / 100}
          aria-valuenow={Math.min(goal.raised, goal.amount) / 100}
          aria-valuetext={`${money(goal.raised)} ${goalOf}`}
        >
          <i class={progress.percent > 0 ? 'some' : undefined} style={`width: ${progress.percent.toFixed(2)}%`}></i>
        </div>
        <p class="goal-status">{goalStatus}</p>
      </div>
      <div class="goal-text">
        <p>{g.about}</p>
        <p>{g.beyond}</p>
      </div>
    </div>

    <fieldset class="switch" data-in="settle" style="--d: 60ms">
      <legend class="visually-hidden">{c.periodLabel}</legend>
      {
        store.periods.map((period, i) => (
          <>
            <input class="visually-hidden" type="radio" name="period" id={`period-${i}`} checked={i === 0} />
            <label for={`period-${i}`}>
              {c.periods[i]}
              {period.off > 0 && <span class="off">−{period.off}%</span>}
            </label>
          </>
        ))
      }
    </fieldset>

    <ul class="plans">
      {
        store.plans.map((plan, i) => (
          <li class={`plan card plan-${plan.id}`} data-in="settle" style={`--d: ${120 + i * 70}ms`}>
            <div class="plan-top">
              {/* Geo Ultra+ is Geo Ultra with a gold "+", so the top plan's "+" is drawn apart. */}
              <h2 class="name">
                {i > 0 && plan.name.endsWith('+') ? (
                  <>
                    <span class="name-text">{plan.name.slice(0, -1)}</span>
                    <span class="plus">+</span>
                  </>
                ) : (
                  <span class="name-text">{plan.name}</span>
                )}
              </h2>
              {/* One more block for every plan up. */}
              <span class="tier" aria-hidden="true">
                {store.plans.map((_, n) => (
                  <i class={n <= i ? 'on' : undefined} />
                ))}
              </span>
            </div>

            {
              store.periods.map((period, n) => {
                const price = periodPrice(plan.monthly, period);
                return (
                  <div class={`price p${n}`}>
                    <p class="amount">
                      <span class="currency">R$</span>
                      <strong>{reais(price.perMonth)}</strong>
                      <span class="per">{c.perMonth}</span>
                    </p>
                    <p class="billed">
                      {period.months === 1 ? (
                        c.billedMonthly
                      ) : (
                        <>
                          {c.billed.replace('{total}', money(price.total)).replace('{months}', String(period.months))}
                          <span class="was">
                            {c.instead.split('{full}')[0]}
                            <s>{money(price.full)}</s>
                          </span>
                        </>
                      )}
                    </p>
                  </div>
                );
              })
            }

            <div class="benefits">
              <p class="label">{c.benefitsLabel}</p>
              {c.benefits[plan.id]?.length ? (
                <ul class="checks">
                  {c.benefits[plan.id].map((benefit) => (
                    <li>
                      <span>
                        {painted(benefit).map((piece) =>
                          piece.style ? <span class={`paint paint-${piece.style}`}>{piece.text}</span> : piece.text,
                        )}
                      </span>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="later">{c.benefitsSoon}</p>
              )}
            </div>

            <p class="soon-tag">{pt.common.soon}</p>
          </li>
        ))
      }
    </ul>

    <div class="after">
      <div class="status card" data-in="settle" style="--d: 100ms">
        <div>
          <h2>{c.status.title}</h2>
          <p>{c.status.body}</p>
        </div>
        <a class="btn-solid" href={site.discordUrl} target="_blank" rel="noopener">{c.cta}<Icon name="arrowUpRight" class="arrow" /></a>
      </div>
      <div class="note card" data-in="settle" style="--d: 170ms">
        <h2>{c.note.title}</h2>
        <p>{c.note.body}</p>
      </div>
    </div>
  </section>

  <Closing />
</Base>

<style>
  .store {
    padding-top: 3rem;
  }

  /* The monthly goal: on the left the count and its bar, on the right what it is for. */
  .goal {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 1.5rem 3rem;
    margin-bottom: 2.25rem;
    padding: 1.8rem 1.9rem 1.9rem;
    display: grid;
  }
  .goal-count {
    gap: .9rem;
    display: grid;
  }
  .bar {
    box-shadow: var(--edge-strong);
    background: var(--color-surface-2);
    border-radius: 999px;
    height: .75rem;
    overflow: hidden;
  }
  .bar i {
    background: var(--grad-earth);
    border-radius: inherit;
    height: 100%;
    transition: width 1.1s var(--ease-out) .35s;
    display: block;
  }
  /* A first small amount still shows as a rounded tip. */
  .bar i.some {
    min-width: .75rem;
  }
  :global(.js) .goal:not(:global(.is-in)) .bar i {
    width: 0 !important;
    min-width: 0;
  }
  .goal-status {
    color: var(--color-text-soft);
    font-size: .9375rem;
    font-weight: 600;
  }
  .goal-text {
    gap: .75rem;
    display: grid;
  }
  .goal-text p {
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.55;
  }

  /* How often to pay: three choices side by side, the chosen one raised. */
  .switch {
    box-shadow: var(--edge);
    background: var(--color-surface-2);
    border: 0;
    border-radius: 999px;
    gap: .2rem;
    min-width: 0;
    margin: 0;
    padding: .3rem;
    display: inline-flex;
    position: relative;
  }
  .switch label {
    color: var(--color-text-muted);
    letter-spacing: -.01em;
    white-space: nowrap;
    cursor: pointer;
    border-radius: 999px;
    align-items: center;
    gap: .5rem;
    padding: .6rem 1.05rem;
    font-size: .9375rem;
    font-weight: 600;
    line-height: 1;
    transition: color .2s, background-color .2s, box-shadow .2s;
    display: inline-flex;
  }
  .switch label:hover {
    color: var(--color-text);
  }
  .switch input:checked + label {
    color: var(--color-text);
    background: var(--color-surface);
    box-shadow: var(--edge), 0 3px 8px -4px #00000080;
  }
  .switch input:focus-visible + label {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .off {
    box-shadow: inset 0 0 0 1px var(--color-green-ring);
    color: var(--color-green-strong);
    font-variant-numeric: tabular-nums;
    background: var(--color-green-soft);
    border-radius: 999px;
    padding: .22rem .45rem;
    font-size: .75rem;
  }

  .plans {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
    list-style: none;
    display: grid;
  }
  .plan {
    grid-template-rows: auto auto 1fr auto;
    gap: 1.5rem;
    padding: 1.7rem 1.7rem 1.6rem;
    display: grid;
  }
  .plan-top {
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    display: flex;
  }
  h2 {
    letter-spacing: -.03em;
    font-size: 1.5rem;
  }
  .tier {
    gap: 3px;
    display: inline-flex;
  }
  .tier i {
    box-shadow: var(--edge-strong);
    background: var(--color-surface-2);
    border-radius: 2px;
    width: .65rem;
    height: .65rem;
  }
  /* One block per plan, in that plan's colour. */
  .tier i.on {
    box-shadow: none;
    background: var(--color-green);
  }
  .tier i.on:nth-child(2) {
    background: var(--color-blue);
  }
  .tier i.on:nth-child(3) {
    background: var(--plus-violet);
  }

  /* Each plan looks a step richer than the one below it. Geo+ is the plain one: a green
     name and nothing else. Geo Ultra has a teal-to-blue name with a soft glow and a card
     edged in blue. Geo Ultra+ is Geo Ultra made better: the same colours carried on to
     violet, moving slowly, a gold "+" (Geo Ultra+ is gold in the game too) and a thin
     border in those colours. */
  .plans {
    --plus-teal: #38bfe0;
    --plus-violet: #a08bff;
    --plus-gold: #f2b83c;
    --paint-ultra: linear-gradient(100deg, var(--plus-teal), var(--color-blue-bright));
    --paint-ultra-plus: linear-gradient(100deg, var(--plus-teal), var(--color-blue-bright) 35%, var(--plus-violet) 65%, var(--color-blue-bright) 85%, var(--plus-teal));
  }
  .plan-geo-plus {
    --accent: var(--color-green-strong);
    --accent-paint: linear-gradient(var(--color-green-strong), var(--color-green-strong));
    --check: var(--color-green);
  }
  .plan-geo-ultra {
    --accent-paint: var(--paint-ultra);
    --check: var(--color-blue);
    --glow: #4a8cf78c;
    box-shadow: inset 0 0 0 1px #4a8cf742, var(--shadow-card), 0 22px 44px -30px #4a8cf766;
  }
  .plan-geo-ultra-plus {
    --accent-paint: linear-gradient(100deg, var(--color-blue-bright), var(--plus-violet));
    --check: var(--plus-violet);
    --glow: #a08bff8c;
    background:
      radial-gradient(120% 45% at 50% 0%, #a08bff17, #a08bff00 70%) padding-box,
      var(--grad-surface) padding-box,
      linear-gradient(140deg, var(--plus-teal), var(--color-blue) 40%, var(--plus-violet) 75%, var(--plus-gold)) border-box;
    border: 1.5px solid #0000;
    box-shadow: var(--shadow-card), 0 26px 52px -30px #a08bff66;
  }
  .name {
    align-items: baseline;
    display: inline-flex;
  }
  .plan-geo-plus .name-text {
    color: var(--color-green-strong);
  }
  .plan-geo-ultra .name-text,
  .plan-geo-ultra-plus .name-text {
    color: #0000;
    -webkit-background-clip: text;
    background-clip: text;
    background-image: var(--paint-ultra);
    filter: drop-shadow(0 0 .45rem var(--glow));
  }
  .plan-geo-ultra-plus .name-text {
    background-image: var(--paint-ultra-plus);
    background-size: 250% 100%;
    animation: shimmer 9s ease-in-out infinite alternate;
  }
  .plus {
    color: var(--plus-gold);
    filter: drop-shadow(0 0 .4rem #f5b400a6);
    margin-left: .04em;
  }
  @keyframes shimmer {
    to {
      background-position: 100% 0;
    }
  }
  .plan-geo-ultra .benefits {
    background: #4a8cf70d;
  }
  .plan-geo-ultra-plus .benefits {
    background: linear-gradient(160deg, #4a8cf70d, #a08bff12);
  }
  .plan .checks li:before {
    background: var(--check, var(--color-green));
  }

  /* Painted words (pt.store.benefits): a few words per plan, never whole lines. */
  .paint {
    font-weight: 600;
  }
  .paint-accent,
  .paint-geo-ultra,
  .paint-nome {
    color: #0000;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .paint-accent {
    background-image: var(--accent-paint);
  }
  .paint-geo-plus {
    color: var(--color-green-strong);
  }
  .paint-geo-ultra {
    background-image: var(--paint-ultra);
  }
  /* What a coloured name looks like: the colour tool's green to blue, ending in violet. */
  .paint-nome {
    background-image: linear-gradient(90deg, var(--color-green-strong), var(--plus-teal) 45%, var(--plus-violet));
  }
  /* The green-yellow of experience orbs. */
  .paint-xp {
    color: #a6e34f;
    text-shadow: 0 0 .6rem #a6e34f4d;
  }
  /* The skin packs, each in its own colour (the same as in the game's menu). */
  .paint-silvestre {
    color: #69d37a;
  }
  .paint-glacial {
    color: #5fd6f0;
  }
  .paint-draconico {
    color: #ff8150;
  }
  .paint-abissal {
    color: #c897ff;
  }
  .paint-celestial {
    color: #f5c542;
    text-shadow: 0 0 .55rem #f5c54259;
  }

  @media (prefers-reduced-motion: reduce) {
    .plan-geo-ultra-plus .name-text {
      animation: none;
    }
  }

  /* Every card holds the price for each way of paying; only the chosen one shows. */
  .price {
    gap: .7rem;
    display: none;
  }
  .store:has(#period-0:checked) .p0,
  .store:has(#period-1:checked) .p1,
  .store:has(#period-2:checked) .p2 {
    display: grid;
  }
  .amount {
    align-items: baseline;
    gap: .4rem;
    display: flex;
  }
  .currency {
    color: var(--color-text-soft);
    font-size: 1.125rem;
    font-weight: 600;
  }
  strong {
    font-variant-numeric: tabular-nums;
    letter-spacing: -.045em;
    font-size: clamp(2.6rem, 1.9rem + 1.6vw, 3.25rem);
    font-weight: 600;
    line-height: 1;
  }
  .per,
  .billed {
    color: var(--color-text-muted);
    font-size: .9375rem;
  }
  /* Two lines in every card, whatever the way of paying, so the cards stay aligned:
     what is charged, and under it what the same months cost without the discount. */
  .billed {
    min-height: 2.9em;
    line-height: 1.45;
  }
  .was {
    color: var(--color-text-faint);
    display: block;
  }

  .benefits {
    box-shadow: var(--edge);
    background: var(--color-bg-tint);
    border-radius: .9rem;
    align-content: start;
    gap: .6rem;
    padding: 1.05rem 1.15rem 1.15rem;
    display: grid;
  }
  .later {
    color: var(--color-text-muted);
    font-size: .9375rem;
    line-height: 1.5;
  }
  .soon-tag {
    box-shadow: inset 0 0 0 1px var(--color-green-ring);
    color: var(--color-green-strong);
    background: var(--color-green-soft);
    border-radius: 999px;
    justify-self: start;
    padding: .4rem .75rem;
    font-size: .8125rem;
    font-weight: 600;
    line-height: 1;
  }

  .after {
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 1rem;
    margin-top: 1rem;
    display: grid;
  }
  .status,
  .note {
    padding: 1.5rem 1.6rem;
  }
  .status {
    justify-content: space-between;
    align-items: center;
    gap: 1.25rem;
    display: flex;
  }
  .status div,
  .note {
    align-content: start;
    gap: .4rem;
    display: grid;
  }
  .after h2 {
    letter-spacing: -.025em;
    font-size: 1.1875rem;
  }
  .after p {
    color: var(--color-text-muted);
    font-size: .9375rem;
    line-height: 1.55;
  }

  /* A browser too old to follow the switch: show every price, each saying its period. */
  @supports not selector(:has(*)) {
    .switch {
      display: none;
    }
    .price {
      display: grid;
    }
  }

  @media (width <= 900px) {
    .goal,
    .plans,
    .after {
      grid-template-columns: minmax(0, 1fr);
    }
    .plan {
      gap: 1.25rem;
    }
  }
  @media (width <= 560px) {
    .switch {
      display: flex;
    }
    .switch label {
      flex: 1;
      justify-content: center;
      gap: .35rem;
      padding: .65rem .5rem;
      font-size: .875rem;
    }
    .status {
      flex-direction: column;
      align-items: flex-start;
    }
    .goal {
      padding: 1.4rem 1.3rem 1.5rem;
    }
  }
</style>
