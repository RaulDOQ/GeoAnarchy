// Cloudflare Workers config for the GeoAnarchy website. The site is fully static:
// `npm run build` writes it to dist/ and Cloudflare serves those files as they are.
// There is no server code and there are no secrets.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "geoanarchy-website",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // Unknown addresses get the site's 404 page; /pagina and /pagina/ both work.
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Cloudflare builds every branch other than main as a Preview (`npx wrangler preview`),
  // and that command refuses to run without this block. It can stay empty: the Preview
  // uses the same static files as the live site.
  "previews": {}
}
