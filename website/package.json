{
  "name": "geoanarchy-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Site do servidor GeoAnarchy (Minecraft survival no mapa da Terra).",
  "scripts": {
    "postinstall": "node scripts/detect-map.mjs --offline",
    "dev": "node scripts/detect-map.mjs && astro dev",
    "build": "node scripts/detect-map.mjs && npm run check && astro build",
    "preview": "astro preview",
    "check": "astro check && tsc -p worker && npm test",
    "test": "node --test worker/snapshots.test.ts worker/copy.test.ts"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "2.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@cloudflare/workers-types": "5.20261123.1",
    "typescript": "5.9.3",
    "wrangler": "4.166.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
